#Область ПрограммныйИнтерфейс

// Передаёт команду в #map-command-bridge страницы, как мост цифрового двойника D3 и карты V1.
//
// Параметры:
//  ДокументHTML - ВнешнийОбъект - документ поля HTML;
//  ТекстКоманды - Строка - JSON команды.
//
// Возвращаемое значение:
//  Булево - Ложь, если мост ещё не готов принимать команды.
Функция ОтправитьКоманду(ДокументHTML, ТекстКоманды) Экспорт

	Попытка
		Мост = ДокументHTML.getElementById("map-command-bridge");
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если Мост = Неопределено Или АтрибутHTML(Мост, "data-ready") <> "true" Тогда
		Возврат Ложь;
	КонецЕсли;

	НомерКоманды = 0;
	ПредыдущийНомер = АтрибутHTML(Мост, "data-seq");
	Если Не ПустаяСтрока(ПредыдущийНомер) Тогда
		НомерКоманды = Число(ПредыдущийНомер);
	КонецЕсли;
	НомерКоманды = Формат(НомерКоманды + 1, "ЧГ=0");

	Мост.setAttribute("data-ack", "");
	Мост.setAttribute("data-error", "");
	Мост.setAttribute("data-result", "");
	Мост.setAttribute("data-payload", ТекстКоманды);
	Мост.setAttribute("data-seq", НомерКоманды);
	Попытка
		Мост.click();
	Исключение
		Мост.fireEvent("onclick");
	КонецПопытки;

	Если АтрибутHTML(Мост, "data-ack") <> НомерКоманды Тогда
		ВызватьИсключение НСтр("ru = 'Карта не подтвердила команду'");
	КонецЕсли;
	ТекстОшибки = АтрибутHTML(Мост, "data-error");
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Результат последней команды, который страница кладёт в data-result моста (например, длина принятой строки).
//
// Параметры:
//  ДокументHTML - ВнешнийОбъект - документ поля HTML.
//
// Возвращаемое значение:
//  Строка
Функция РезультатКоманды(ДокументHTML) Экспорт

	Попытка
		Возврат АтрибутHTML(ДокументHTML.getElementById("map-command-bridge"), "data-result");
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Тип события #map-event-bridge по адресу ссылки «#event:<тип>».
//
// Параметры:
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события ПриНажатии поля HTML.
//
// Возвращаемое значение:
//  Строка - тип события; пустая строка, если нажатие - не событие карты.
Функция ТипСобытия(ДанныеСобытия) Экспорт

	Href = АдресНажатия(ДанныеСобытия);
	Позиция = СтрНайти(Href, "#event:");
	Возврат ?(Позиция = 0, "", Сред(Href, Позиция + СтрДлина("#event:")));

КонецФункции

// Адрес внешней ссылки (атрибуция), которую надо открыть в браузере, а не в поле.
//
// Параметры:
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события ПриНажатии поля HTML.
//
// Возвращаемое значение:
//  Строка - адрес http(s); пустая строка, если ссылка не внешняя.
Функция ВнешняяСсылка(ДанныеСобытия) Экспорт

	Href = АдресНажатия(ДанныеСобытия);
	Если СтрНачинаетсяС(НРег(Href), "http://") Или СтрНачинаетсяС(НРег(Href), "https://") Тогда
		Возврат Href;
	КонецЕсли;
	Возврат "";

КонецФункции

// Атрибут узла, по которому кликнул JS (#map-event-bridge): данные события лежат в его data-*.
//
// Параметры:
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события ПриНажатии поля HTML;
//  ИмяАтрибута - Строка - например, "data-message".
//
// Возвращаемое значение:
//  Строка
Функция АтрибутУзлаСобытия(ДанныеСобытия, ИмяАтрибута) Экспорт

	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Узел = Неопределено;
	КонецПопытки;
	Если Узел = Неопределено Тогда
		Попытка
			Узел = ДанныеСобытия.Element;
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЕсли;
	Возврат АтрибутHTML(Узел, ИмяАтрибута);

КонецФункции

// Имя оповещения, которым карточка судна передаёт форме карты новый список отслеживаемых судов.
// Параметр оповещения - см. Обработки.КартаПодходаСудовV2.КомандаСпискаОтслеживаемых.
//
// Возвращаемое значение:
//  Строка
Функция СобытиеСпискаОтслеживаемых() Экспорт

	Возврат "ОтслеживаемыеСудаV2Изменены";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресНажатия(ДанныеСобытия)

	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Возврат Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат "";

КонецФункции

Функция АтрибутHTML(Узел, ИмяАтрибута)

	Попытка
		Значение = Узел.getAttribute(ИмяАтрибута);
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

#КонецОбласти
