	Возврат "tiles.openfreemap.org";

КонецФункции

// Стек шрифтов - text-font.join(","), тем же правилом, что MapLibre подставляет {fontstack}.
Процедура ДобавитьСтекиШрифтов(Стиль, СтекиШрифтов)

	Слои = Стиль.Получить("layers");
	Если ТипЗнч(Слои) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Слой Из Слои Цикл
		Раскладка = Слой.Получить("layout");
		Шрифты = ?(ТипЗнч(Раскладка) = Тип("Соответствие"), Раскладка.Получить("text-font"), Неопределено);
		Если ТипЗнч(Шрифты) <> Тип("Массив") Или Шрифты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имена = Новый Массив;
		Для Каждого Шрифт Из Шрифты Цикл
			Если ТипЗнч(Шрифт) <> Тип("Строка") Тогда
				Имена = Неопределено;
				Прервать;
			КонецЕсли;
			Имена.Добавить(Шрифт);
		КонецЦикла;
		Если Имена <> Неопределено И СтекиШрифтов.Найти(СтрСоединить(Имена, ",")) = Неопределено Тогда
			СтекиШрифтов.Добавить(СтрСоединить(Имена, ","));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Тайлы XYZ, пересекающие bbox набора, включая краевые, по шаблону адреса из TileJSON.
Процедура ДобавитьТайлы(TileJSON, Параметры, Ресурсы)

	Шаблоны = TileJSON.Получить("tiles");
	Если ТипЗнч(Шаблоны) <> Тип("Массив") Или Шаблоны.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В TileJSON нет адреса тайлов'");
	КонецЕсли;
	Адрес = РазобратьАдрес(Шаблоны[0]);
	Границы = Параметры.bbox;
	Для Масштаб = Параметры.minZoom По Параметры.maxZoom Цикл
		Количество = Pow(2, Масштаб);
		Для X = ТайлX(Границы[0], Количество) По ТайлX(Границы[2], Количество) Цикл
			Для Y = ТайлY(Границы[3], Количество) По ТайлY(Границы[1], Количество) Цикл
				Путь = СтрЗаменить(СтрЗаменить(СтрЗаменить(Адрес.Путь,
					"{z}", Формат(Масштаб, "ЧГ=0")), "{x}", Формат(X, "ЧН=0; ЧГ=0")), "{y}", Формат(Y, "ЧН=0; ЧГ=0"));
				Ключ = СтрШаблон("tiles/%1/%2/%3", Формат(Масштаб, "ЧГ=0"), Формат(X, "ЧН=0; ЧГ=0"), Формат(Y, "ЧН=0; ЧГ=0"));
				Ресурсы.Добавить(ОписаниеРесурса(Ключ, Адрес.Хост, Путь, Параметры.tileTimeout, Ложь));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ТайлX(Долгота, Количество)

	Возврат Цел((Долгота + 180) / 360 * Количество);

КонецФункции

Функция ТайлY(Широта, Количество)

	Радианы = Широта * ЧислоПи() / 180;
	Возврат Цел((1 - Log(Tan(Радианы) + 1 / Cos(Радианы)) / ЧислоПи()) / 2 * Количество);

КонецФункции

Функция ЧислоПи()

	Возврат 3.14159265358979;

КонецФункции

// Overpass принимает bbox в порядке юг,запад,север,восток - в отличие от остальной конфигурации.
Функция ЗапросOverpass(Границы)

	Порядок = СтрШаблон("%1,%2,%3,%4",
		ЧислоВСтроку(Границы[1]), ЧислоВСтроку(Границы[0]), ЧислоВСтроку(Границы[3]), ЧислоВСтроку(Границы[2]));
	Возврат "[out:json][timeout:120];(nwr[""seamark:type""](" + Порядок + "););out geom;";

КонецФункции

// Возвращаемое значение:
//  Структура:
//   * Хост - Строка
//   * Путь - Строка
Функция РазобратьАдрес(АдресURL)

	Без = АдресURL;
	Если СтрНачинаетсяС(НРег(Без), "https://") Тогда
		Без = Сред(Без, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Без), "http://") Тогда
		Без = Сред(Без, 8);
	КонецЕсли;
	Позиция = СтрНайти(Без, "/");
	Результат = Новый Структура;
	Результат.Вставить("Хост", ?(Позиция = 0, Без, Лев(Без, Позиция - 1)));
	Результат.Вставить("Путь", ?(Позиция = 0, "/", Сред(Без, Позиция)));
	Возврат Результат;

КонецФункции

Функция ПоследнийСегмент(Путь)

	Части = СтрРазделить(Путь, "/", Ложь);
	Возврат ?(Части.Количество() = 0, "", Части[Части.Количество() - 1]);

