// Возвращаемое значение:
//  Структура:
//   * Пакетов - Число
//   * Ресурсов - Число
Функция ИтогПакетов(Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Пакеты.Номер) КАК Пакетов,
		|	ЕСТЬNULL(СУММА(Пакеты.КоличествоРесурсов), 0) КАК Ресурсов
		|ИЗ
		|	РегистрСведений.ПакетыКартыV2 КАК Пакеты
		|ГДЕ
		|	Пакеты.Набор = &Набор";
	Запрос.УстановитьПараметр("Набор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Итог = Новый Структура;
	Итог.Вставить("Пакетов", Выборка.Пакетов);
	Итог.Вставить("Ресурсов", Выборка.Ресурсов);
	Возврат Итог;

