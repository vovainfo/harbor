#Область ПрограммныйИнтерфейс

#Область ПараметрыИРесурсы

// Параметры набора картографических данных. Район берётся из ПолучениеДанныхAISV2.ПараметрыРайона(),
// чтобы район судов и кеша был задан в одном месте.
//
// Возвращаемое значение:
//  Структура:
//   * bbox - Массив из Число - [lonMin, latMin, lonMax, latMax] района кеша;
//   * minZoom - Число - нижний масштаб векторных тайлов, совпадает с minZoom карты;
//   * maxZoom - Число - верхний масштаб векторных тайлов, maxzoom источника OpenFreeMap;
//   * styles - Массив из Строка - имена стилей OpenFreeMap;
//   * glyphRanges - Массив из Строка - диапазоны шрифтов;
//   * packageSize - Число - целевой размер пакета, символов;
//   * tileTimeout - Число - таймаут запросов к OpenFreeMap, с;
//   * overpassTimeout - Число - таймаут запроса Overpass, с;
//   * overpassHosts - Массив из Строка - адреса Overpass по порядку; пустой - без морской обстановки.
Функция ПараметрыНабора() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("bbox", ПолучениеДанныхAISV2.ПараметрыРайона().bbox);
	Параметры.Вставить("minZoom", 11);
	Параметры.Вставить("maxZoom", 14);
	Параметры.Вставить("styles", СтрРазделить("positron,liberty", ","));
	Параметры.Вставить("glyphRanges", СтрРазделить("0-255,256-511,1024-1279,8192-8447,8448-8703,9472-9727", ","));
	// Порог моста 1С ↔ V8WebKit уточняется диагностикой V2; при необходимости меняется только здесь.
	Параметры.Вставить("packageSize", 1500000);
	Параметры.Вставить("tileTimeout", 30);
	// Замер 17.10.2026: 38-42 с на ближнюю зону и район, поэтому 120 с и [timeout:120] в запросе.
	Параметры.Вставить("overpassTimeout", 120);
	Параметры.Вставить("overpassHosts", СтрРазделить("z.overpass-api.de,overpass-api.de", ","));
	Возврат Параметры;

КонецФункции

// Параметры маленького тестового набора для формы диагностики: тайлы z14 вокруг ВМКТ, два диапазона шрифтов,
// спрайт, без морской обстановки. Скачивается тем же кодом, что и полный набор.
//
// Возвращаемое значение:
//  см. ПараметрыНабора
Функция ПараметрыДиагностики() Экспорт

	Параметры = ПараметрыНабора();
	Терминал = ПолучениеДанныхAISV2.ПараметрыРайона().terminal;
	Параметры.bbox = МассивЧисел(Терминал[0] - 0.01, Терминал[1] - 0.01, Терминал[0] + 0.01, Терминал[1] + 0.01);
	Параметры.minZoom = 14;
	Параметры.styles = СтрРазделить("positron", ",");
	// 0-255 - цифры и латиница подписей, 1024-1279 - кириллица.
	Параметры.glyphRanges = СтрРазделить("0-255,1024-1279", ",");
	Параметры.overpassHosts = Новый Массив;
	Возврат Параметры;

КонецФункции

// Начальные ресурсы набора - стили и TileJSON; по ним строится остальной список.
//
// Параметры:
//  Параметры - см. ПараметрыНабора
//
// Возвращаемое значение:
//  Массив из см. ОписаниеРесурса
Функция НачальныеРесурсы(Параметры) Экспорт

	Ресурсы = Новый Массив;
	Для Каждого Стиль Из Параметры.styles Цикл
		Ресурсы.Добавить(ОписаниеРесурса(КлючСтиля(Стиль), ХостOpenFreeMap(), "/styles/" + Стиль,
			Параметры.tileTimeout, Истина));
	КонецЦикла;
	Ресурсы.Добавить(ОписаниеРесурса(КлючTileJSON(), ХостOpenFreeMap(), "/planet", Параметры.tileTimeout, Истина));
	Возврат Ресурсы;

КонецФункции

// Остальные ресурсы набора: спрайт, шрифты, морская обстановка и тайлы. Ключ ресурса - адрес, который
// запросит MapLibre 1.15.3, без схемы harbor:// (у шрифтов пробелы не кодируются и остаётся .pbf).
//
// Параметры:
//  ТекстыНачальныхРесурсов - Соответствие из КлючИЗначение - ключ ресурса из НачальныеРесурсы и текст ответа (JSON);
//  Параметры - см. ПараметрыНабора
//
// Возвращаемое значение:
//  Массив из см. ОписаниеРесурса
Функция ОстальныеРесурсы(ТекстыНачальныхРесурсов, Параметры) Экспорт

	Ресурсы = Новый Массив;
	Спрайты = Новый Массив;
	СтекиШрифтов = Новый Массив;
	Для Каждого ИмяСтиля Из Параметры.styles Цикл
		Стиль = ОбъектJSON(ТекстыНачальныхРесурсов.Получить(КлючСтиля(ИмяСтиля)));
		Спрайт = Стиль.Получить("sprite");
		Если ТипЗнч(Спрайт) = Тип("Строка") И Спрайты.Найти(Спрайт) = Неопределено Тогда
			Спрайты.Добавить(Спрайт);
		КонецЕсли;
		ДобавитьСтекиШрифтов(Стиль, СтекиШрифтов);
	КонецЦикла;

	Для Каждого Спрайт Из Спрайты Цикл
		Адрес = РазобратьАдрес(Спрайт);
		Имя = ПоследнийСегмент(Адрес.Путь);
		Для Каждого Суффикс Из СтрРазделить(".json,.png,@2x.json,@2x.png", ",") Цикл
			Ресурсы.Добавить(ОписаниеРесурса("sprite/" + Имя + Суффикс, Адрес.Хост, Адрес.Путь + Суффикс,
				Параметры.tileTimeout, Истина));
		КонецЦикла;
	КонецЦикла;

	Для Каждого Стек Из СтекиШрифтов Цикл
		Для Каждого Диапазон Из Параметры.glyphRanges Цикл
			Ресурсы.Добавить(ОписаниеРесурса("glyphs/" + Стек + "/" + Диапазон + ".pbf", ХостOpenFreeMap(),
				"/fonts/" + КодироватьСтроку(Стек, СпособКодированияСтроки.КодировкаURL) + "/" + Диапазон + ".pbf",
				Параметры.tileTimeout, Ложь));
		КонецЦикла;
	КонецЦикла;

	Если Параметры.overpassHosts.Количество() > 0 Тогда
		Ресурсы.Добавить(ОписаниеРесурса("seamark/overpass", Параметры.overpassHosts,
			"/api/interpreter?data=" + КодироватьСтроку(ЗапросOverpass(Параметры.bbox), СпособКодированияСтроки.КодировкаURL),
			Параметры.overpassTimeout, Ложь, Истина));
	КонецЕсли;

	ДобавитьТайлы(ОбъектJSON(ТекстыНачальныхРесурсов.Получить(КлючTileJSON())), Параметры, Ресурсы);
	Возврат Ресурсы;

КонецФункции

#КонецОбласти

#Область ЖизненныйЦиклНабора

// Начинает загрузку нового набора. Брошенные загрузки (статус «загружается») переводятся в «ошибку»
// вместе с удалением пакетов: одновременно грузит один администратор, второго такого набора не бывает.
//
// Возвращаемое значение:
//  Структура:
//   * Набор - Строка - идентификатор нового набора;
//   * Параметры - см. ПараметрыНабора
Функция НачатьНабор() Экспорт

	ПроверитьПравоИзменения();
	Параметры = ПараметрыНабора();
	Набор = Новый УникальныйИдентификатор;

	НачатьТранзакцию();
	Попытка
		БлокировкаНаборов().Заблокировать();
		Для Каждого Брошенный Из НаборыВСтатусе(СтатусЗагружается()) Цикл
			УстановитьСтатус(Брошенный, СтатусОшибка());
			УдалитьПакеты(Брошенный);
		КонецЦикла;
		Запись = РегистрыСведений.НаборыКартыV2.СоздатьМенеджерЗаписи();
		Запись.Набор = Набор;
		Запись.Статус = СтатусЗагружается();
		Запись.ДатаСоздания = ТекущаяУниверсальнаяДата();
		Запись.ПараметрыJSON = ТекстJSON(Параметры);
		Запись.Загрузил = ИмяПользователя();
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация, СтрШаблон(НСтр("ru = 'Начата загрузка набора %1'"), Набор));
	Результат = Новый Структура;
	Результат.Вставить("Набор", Строка(Набор));
	Результат.Вставить("Параметры", Параметры);
	Возврат Результат;

КонецФункции

// Записывает пакет набора. Повтор с тем же номером перезаписывает пакет, а не добавляет второй.
//
// Параметры:
//  Набор - Строка - идентификатор набора;
//  Номер - Число - номер пакета с 1;
//  ТекстПакета - Строка - JSON пакета;
//  КоличествоРесурсов - Число - ресурсов в пакете.
Процедура ЗаписатьПакет(Набор, Номер, ТекстПакета, КоличествоРесурсов) Экспорт

	ПроверитьПравоИзменения();
	Идентификатор = Новый УникальныйИдентификатор(Набор);
	Если СтатусНабора(Идентификатор) <> СтатусЗагружается() Тогда
		ВызватьИсключение НСтр("ru = 'Набор не находится в загрузке'");
	КонецЕсли;
	Пакеты = РегистрыСведений.ПакетыКартыV2.СоздатьНаборЗаписей();
	Пакеты.Отбор.Набор.Установить(Идентификатор);
	Пакеты.Отбор.Номер.Установить(Номер);
	Строка = Пакеты.Добавить();
	Строка.Набор = Идентификатор;
	Строка.Номер = Номер;
	Строка.ДанныеJSON = ТекстПакета;
	Строка.КоличествоРесурсов = КоличествоРесурсов;
	Строка.Размер = СтрДлина(ТекстПакета);
	Пакеты.Записать();

КонецПроцедуры

// Активирует полностью загруженный набор: текущий активный становится предыдущим, прежний предыдущий
// и ошибочные старше суток удаляются. Пакеты предыдущего хранятся до следующей активации: форма,
// открытая во время смены набора, дочитывает пакеты старого набора по его идентификатору.
//
// Параметры:
//  Набор - Строка - идентификатор набора;
//  Манифест - Структура - итог загрузки с клиента:
//   * Пакетов - Число - передано пакетов;
//   * Ресурсов - Число - ресурсов в пакетах;
//   * Пропущено - Число - пропущено ресурсов (404, пустые ответы);
//   * Байт - Число - объём ресурсов до base64.
Процедура ЗавершитьНабор(Набор, Манифест) Экспорт

	ПроверитьПравоИзменения();
	Идентификатор = Новый УникальныйИдентификатор(Набор);

	НачатьТранзакцию();
	Попытка
		БлокировкаНаборов().Заблокировать();
		Если СтатусНабора(Идентификатор) <> СтатусЗагружается() Тогда
			ВызватьИсключение НСтр("ru = 'Набор не находится в загрузке'");
		КонецЕсли;
		Итог = ИтогПакетов(Идентификатор);
		Если Итог.Пакетов <> Манифест.Пакетов Или Итог.Ресурсов <> Манифест.Ресурсов Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Пакеты набора не совпадают с манифестом: на сервере %1 / %2, у клиента %3 / %4'"),
				Итог.Пакетов, Итог.Ресурсов, Манифест.Пакетов, Манифест.Ресурсов);
		КонецЕсли;

		Для Каждого Предыдущий Из НаборыВСтатусе(СтатусПредыдущий()) Цикл
			УдалитьНабор(Предыдущий);
		КонецЦикла;
		Для Каждого Активный Из НаборыВСтатусе(СтатусАктивен()) Цикл
			УстановитьСтатус(Активный, СтатусПредыдущий());
		КонецЦикла;
		Граница = ТекущаяУниверсальнаяДата() - 86400;
		Для Каждого Ошибочный Из НаборыВСтатусе(СтатусОшибка()) Цикл
			Если ДатаСозданияНабора(Ошибочный) < Граница Тогда
				УдалитьНабор(Ошибочный);
			КонецЕсли;
		КонецЦикла;

		Запись = РегистрыСведений.НаборыКартыV2.СоздатьМенеджерЗаписи();
		Запись.Набор = Идентификатор;
		Запись.Прочитать();
		Запись.Статус = СтатусАктивен();
		Запись.ДатаАктивации = ТекущаяУниверсальнаяДата();
		Запись.МанифестJSON = ТекстJSON(Манифест);
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
		СтрШаблон(НСтр("ru = 'Набор %1 активирован: пакетов %2, ресурсов %3, пропущено %4, байт %5'"),
			Набор, Манифест.Пакетов, Манифест.Ресурсов, Манифест.Пропущено, Формат(Манифест.Байт, "ЧГ=0")));

КонецПроцедуры

// Отменяет загружаемый набор: статус «ошибка», пакеты удаляются. Активный набор не меняется.
//
// Параметры:
//  Набор - Строка - идентификатор набора.
Процедура ОтменитьНабор(Набор) Экспорт

	ПроверитьПравоИзменения();
	Идентификатор = Новый УникальныйИдентификатор(Набор);
	НачатьТранзакцию();
	Попытка
		БлокировкаНаборов().Заблокировать();
		Если СтатусНабора(Идентификатор) = СтатусЗагружается() Тогда
			УстановитьСтатус(Идентификатор, СтатусОшибка());
			УдалитьПакеты(Идентификатор);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение, СтрШаблон(НСтр("ru = 'Загрузка набора %1 отменена'"), Набор));

КонецПроцедуры

#КонецОбласти

#Область ЧтениеНабора

// Активный набор для формы карты.
//
// Возвращаемое значение:
//  Структура - активный набор; если его нет, Набор - пустая строка:
//   * Набор - Строка - идентификатор;
//   * Пакетов - Число - количество пакетов;
//   * ДатаАктивации - Дата - дата активации, UTC.
Функция АктивныйНабор() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Набор", "");
	Результат.Вставить("Пакетов", 0);
	Результат.Вставить("ДатаАктивации", Дата(1, 1, 1));
	Активные = НаборыВСтатусе(СтатусАктивен());
	Если Активные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Набор = Строка(Активные[0]);
	Результат.Пакетов = ИтогПакетов(Активные[0]).Пакетов;
	Результат.ДатаАктивации = ДатаАктивацииНабора(Активные[0]);
	Возврат Результат;

КонецФункции

// Пакеты набора по номерам - для переноса в HTML-поле при открытии формы.
//
// Параметры:
//  Набор - Строка - идентификатор набора;
//  НомерС - Число - первый номер;
//  НомерПо - Число - последний номер.
//
// Возвращаемое значение:
//  Массив из Строка - тексты пакетов по возрастанию номера.
Функция ПакетыНабора(Набор, НомерС, НомерПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ДанныеJSON КАК ДанныеJSON
		|ИЗ
		|	РегистрСведений.ПакетыКартыV2 КАК Пакеты
		|ГДЕ
		|	Пакеты.Набор = &Набор
		|	И Пакеты.Номер МЕЖДУ &НомерС И &НомерПо
		|УПОРЯДОЧИТЬ ПО
		|	Пакеты.Номер";
	Запрос.УстановитьПараметр("Набор", Новый УникальныйИдентификатор(Набор));
	Запрос.УстановитьПараметр("НомерС", НомерС);
	Запрос.УстановитьПараметр("НомерПо", НомерПо);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДанныеJSON");

КонецФункции

#КонецОбласти

