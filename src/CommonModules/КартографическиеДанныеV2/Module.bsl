#Область Ресурсы

// Возвращаемое значение:
//  Структура:
//   * Ключ - Строка - ключ ресурса в наборе;
//   * Хосты - Массив из Строка - хосты по порядку попыток;
//   * Путь - Строка - путь запроса с параметрами;
//   * Таймаут - Число - таймаут, с;
//   * Обязательный - Булево - 404 у ресурса прерывает загрузку;
//   * ПропуститьПриОшибке - Булево - любая ошибка ресурса - пропуск с предупреждением, а не отказ загрузки.
Функция ОписаниеРесурса(Ключ, Хосты, Путь, Таймаут, Обязательный, ПропуститьПриОшибке = Ложь)

	Ресурс = Новый Структура;
	Ресурс.Вставить("Ключ", Ключ);
	Если ТипЗнч(Хосты) = Тип("Массив") Тогда
		Ресурс.Вставить("Хосты", Хосты);
	Иначе
		Ресурс.Вставить("Хосты", СтрРазделить(Хосты, ","));
	КонецЕсли;
	Ресурс.Вставить("Путь", Путь);
	Ресурс.Вставить("Таймаут", Таймаут);
	Ресурс.Вставить("Обязательный", Обязательный);
	Ресурс.Вставить("ПропуститьПриОшибке", ПропуститьПриОшибке);
	Возврат Ресурс;

КонецФункции

Функция КлючСтиля(Имя)

	Возврат "style/" + Имя;

КонецФункции

Функция КлючTileJSON()

	Возврат "tilejson";

КонецФункции

