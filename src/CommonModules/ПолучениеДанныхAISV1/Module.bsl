#Область ПрограммныйИнтерфейс

// Параметры района карты - единственное место, где они заданы.
// Все координаты в порядке [lon, lat] (RFC 7946); порядок провайдера живёт только в его адаптере.
//
// Возвращаемое значение:
//  Структура:
//   * bbox - Массив из Число - [lonMin, latMin, lonMax, latMax], район запроса судов;
//   * center - Массив из Число - [lon, lat] центра карты при открытии;
//   * zoom - Число - масштаб карты при открытии;
//   * minZoom - Число - минимальный масштаб;
//   * maxZoom - Число - максимальный масштаб;
//   * maxBounds - Массив из Число - [lonMin, latMin, lonMax, latMax], границы сдвига карты;
//   * terminal - Массив из Число - [lon, lat] опорной точки терминала ВМКТ.
Функция ПараметрыРайона() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("bbox", МассивЧисел(131.0, 42.5, 133.0, 43.5));
	Параметры.Вставить("center", МассивЧисел(131.90, 43.08));
	Параметры.Вставить("zoom", 11);
	Параметры.Вставить("minZoom", 8);
	Параметры.Вставить("maxZoom", 18);
	// Запас вокруг bbox: на минимальном масштабе окно шире залива, иначе карту не сдвинуть.
	Параметры.Вставить("maxBounds", МассивЧисел(128.5, 40.5, 135.5, 45.5));
	// Юго-западный угол ограждения ВМКТ из scene_origin цифрового двойника D3.
	Параметры.Вставить("terminal", МассивЧисел(131.8799, 43.0897));
	Возврат Параметры;

КонецФункции

// Получает суда из Open Waters и записывает снимок в регистр СнимкиAISV1.
// Права не проверяет: вызывается регламентом и формой после проверки права изменения снимка.
// Ошибка не меняет прежний снимок; пустой снимок пишется только при пустом ответе провайдера.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно - Булево - снимок записан;
//   * ТекстОшибки - Строка - краткое представление ошибки для пользователя;
//   * КоличествоСудов - Число - принято судов;
//   * Пропущено - Число - отброшено негодных объектов.
Функция ОбновитьСнимокOpenWaters() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоСудов", 0);
	Результат.Вставить("Пропущено", 0);

	Попытка
		ДатаПолучения = ТекущаяУниверсальнаяДата();
		Ответ = ЗапроситьСудаOpenWaters(ПараметрыРайона().bbox);
		Разбор = РазобратьОтветOpenWaters(Ответ, ДатаПолучения);
		ЗаписатьСнимок(ПровайдерOpenWaters(), ДатаПолучения, Разбор);
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		Результат.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация);
		Возврат Результат;
	КонецПопытки;

	Если Разбор.Пропущено > 0 Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			СтрШаблон(НСтр("ru = 'Пропущено негодных объектов: %1 из %2'"),
				Разбор.Пропущено, Разбор.Пропущено + Разбор.Суда.Количество()));
	КонецЕсли;

	Результат.Успешно = Истина;
	Результат.КоличествоСудов = Разбор.Суда.Количество();
	Результат.Пропущено = Разбор.Пропущено;
	Возврат Результат;

КонецФункции

// Метод регламентного задания ПолучитьСудаAISV1. Результат пишется в журнал регистрации.
Процедура ПолучитьСудаOpenWaters() Экспорт

	ОбновитьСнимокOpenWaters();

КонецПроцедуры

// Последний записанный снимок провайдера Open Waters.
//
// Возвращаемое значение:
//  Структура - снимок; если снимка ещё нет, ДатаПолучения пустая:
//   * ДатаПолучения - Дата - дата получения, UTC;
//   * ДанныеJSON - Строка - снимок в формате контракта судна; пустая строка, если снимка нет;
//   * КоличествоСудов - Число - количество судов в снимке;
//   * СамаяСвежаяПозиция - Дата - время самой свежей позиции среди судов, UTC; пустая дата, если судов нет.
Функция ПоследнийСнимок() Экспорт

	Снимок = Новый Структура;
	Снимок.Вставить("ДатаПолучения", Дата(1, 1, 1));
	Снимок.Вставить("ДанныеJSON", "");
	Снимок.Вставить("КоличествоСудов", 0);
	Снимок.Вставить("СамаяСвежаяПозиция", Дата(1, 1, 1));

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СнимкиAIS.ДатаПолучения КАК ДатаПолучения,
		|	СнимкиAIS.ДанныеJSON КАК ДанныеJSON,
		|	СнимкиAIS.КоличествоСудов КАК КоличествоСудов,
		|	СнимкиAIS.СамаяСвежаяПозиция КАК СамаяСвежаяПозиция
		|ИЗ
		|	РегистрСведений.СнимкиAISV1 КАК СнимкиAIS
		|ГДЕ
		|	СнимкиAIS.Провайдер = &Провайдер";
	Запрос.УстановитьПараметр("Провайдер", ПровайдерOpenWaters());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Снимок, Выборка);
	КонецЕсли;
	Возврат Снимок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗапросOpenWaters

Функция ПровайдерOpenWaters()

	Возврат "openwaters";

КонецФункции

Функция ЗапроситьСудаOpenWaters(Район)

	Соединение = Новый HTTPСоединение("ais.openwaters.io", 443, , ,
		Новый ИнтернетПрокси(Истина), 30, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос = Новый HTTPЗапрос(АдресЗапросаOpenWaters(Район));
	Запрос.Заголовки.Вставить("Accept", "application/geo+json, application/json");
	Токен = ТокенOpenWaters();
	Если ЗначениеЗаполнено(Токен) Тогда
		// Способ передачи токена в документации Open Waters не описан: заголовок - предположение по CORS.
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;

	Ответ = Соединение.Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Open Waters вернул код состояния %1'"), Ответ.КодСостояния);
	КонецЕсли;
	Возврат Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

КонецФункции

// Open Waters принимает bbox в порядке lat_min,lon_min,lat_max,lon_max - в отличие от остальной конфигурации.
Функция АдресЗапросаOpenWaters(Район)

	Возврат СтрШаблон("/v1/vessels?bbox=%1,%2,%3,%4",
		ЧислоВСтроку(Район[1]), ЧислоВСтроку(Район[0]), ЧислоВСтроку(Район[3]), ЧислоВСтроку(Район[2]));

КонецФункции

Функция ТокенOpenWaters()

	УстановитьПривилегированныйРежим(Истина);
	Токен = Константы.ТокенOpenWaters.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат СокрЛП(Токен);

КонецФункции

#КонецОбласти

#Область РазборОтвета

// Возвращаемое значение:
//  Структура:
//   * Суда - Массив из Структура - суда в формате контракта;
//   * Пропущено - Число - отброшено негодных объектов;
//   * СамаяСвежаяПозиция - Дата - время самой свежей позиции, UTC;
//   * Атрибуция - Строка - тексты атрибуции встреченных источников.
Функция РазобратьОтветOpenWaters(ТелоОтвета, ДатаПолучения)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТелоОтвета);
	// Соответствие: поля необязательны, а ключи attribution и name:* - произвольные строки.
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Объекты = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("features"), Неопределено);
	Если ТипЗнч(Объекты) <> Тип("Массив") Тогда
		ВызватьИсключение НСтр("ru = 'В ответе Open Waters нет массива features'");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Суда", Новый Массив);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("СамаяСвежаяПозиция", Дата(1, 1, 1));
	Источники = Новый Массив;

	Для Каждого Объект Из Объекты Цикл
		Судно = СудноИзОбъектаOpenWaters(Объект);
		Если Судно = Неопределено Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Результат.Суда.Добавить(Судно.Контракт);
		Результат.СамаяСвежаяПозиция = Макс(Результат.СамаяСвежаяПозиция, Судно.ДатаПозиции);
		Если ЗначениеЗаполнено(Судно.Контракт.source) И Источники.Найти(Судно.Контракт.source) = Неопределено Тогда
			Источники.Добавить(Судно.Контракт.source);
		КонецЕсли;
	КонецЦикла;

	// Провайдер, вероятно, сменил формат: пустой снимок стёр бы прежний.
	Если Объекты.Количество() > 0 И Результат.Суда.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Все объекты ответа Open Waters отброшены (%1), снимок не изменён'"), Объекты.Количество());
	КонецЕсли;

	Результат.Вставить("Атрибуция", АтрибуцияИсточников(Данные.Получить("attribution"), Источники));
	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//  Структура, Неопределено - принятое судно; Неопределено, если нет mmsi, координат или времени позиции:
//   * Контракт - Структура - судно в формате контракта;
//   * ДатаПозиции - Дата - время позиции, UTC.
Функция СудноИзОбъектаOpenWaters(Объект)

	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Свойства = Объект.Получить("properties");
	Если ТипЗнч(Свойства) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	MMSI = ЧислоСвойства(Свойства, "mmsi");
	Если MMSI = Неопределено Тогда
		MMSI = ?(ТипЗнч(Объект.Получить("id")) = Тип("Число"), Объект.Получить("id"), Неопределено);
	КонецЕсли;
	Если MMSI = Неопределено Или MMSI <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Координаты = КоординатыОбъекта(Объект);
	Если Координаты = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДатаПозиции = ДатаИзISO(Свойства.Получить("seen"));
	Если ДатаПозиции = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Контракт = Новый Структура;
	Контракт.Вставить("mmsi", MMSI);
	Контракт.Вставить("imo", ПоложительноеИлиNull(ЧислоСвойства(Свойства, "imo")));
	Контракт.Вставить("name", СтрокаСвойства(Свойства, "name"));
	Контракт.Вставить("callsign", СтрокаСвойства(Свойства, "callsign"));
	Контракт.Вставить("shipType", ЧислоСвойства(Свойства, "type"));
	Контракт.Вставить("flag", СтрокаСвойства(Свойства, "flag"));
	Контракт.Вставить("lon", Координаты[0]);
	Контракт.Вставить("lat", Координаты[1]);
	// Значения «нет данных» по ITU-R M.1371: sog 102.3, cog 360, heading 511.
	Контракт.Вставить("sog", МеньшеИлиNull(ЧислоСвойства(Свойства, "sog"), 102.3));
	Контракт.Вставить("cog", МеньшеИлиNull(ЧислоСвойства(Свойства, "cog"), 360));
	Контракт.Вставить("heading", МеньшеИлиNull(ЧислоСвойства(Свойства, "heading"), 360));
	Контракт.Вставить("navStatus", ЧислоСвойства(Свойства, "nav_status"));
	Контракт.Вставить("draught", ПоложительноеИлиNull(ЧислоСвойства(Свойства, "draught")));
	Контракт.Вставить("destination", СтрокаСвойства(Свойства, "destination"));
	Контракт.Вставить("eta", СтрокаСвойства(Свойства, "eta"));
	Контракт.Вставить("seen", ДатаВISO(ДатаПозиции));
	Контракт.Вставить("source", СтрокаСвойства(Свойства, "source"));
	ЗаполнитьРазмеры(Контракт, Свойства);

	Результат = Новый Структура;
	Результат.Вставить("Контракт", Контракт);
	Результат.Вставить("ДатаПозиции", ДатаПозиции);
	Возврат Результат;

КонецФункции

// Размеры по ITU-R M.1371-5 § 3.3.3: A = toBow, B = toStern, C = toPort, D = toStarboard.
// Ноль - расстояние от антенны до кромки, а не «нет данных».
Процедура ЗаполнитьРазмеры(Контракт, Свойства)

	КНосу = НеотрицательноеИлиNull(ЧислоСвойства(Свойства, "to_bow"));
	ККорме = НеотрицательноеИлиNull(ЧислоСвойства(Свойства, "to_stern"));
	КЛевомуБорту = НеотрицательноеИлиNull(ЧислоСвойства(Свойства, "to_port"));
	КПравомуБорту = НеотрицательноеИлиNull(ЧислоСвойства(Свойства, "to_starboard"));

	ВсеИзвестны = КНосу <> Неопределено И ККорме <> Неопределено
		И КЛевомуБорту <> Неопределено И КПравомуБорту <> Неопределено;
	Если ВсеИзвестны И КНосу + ККорме + КЛевомуБорту + КПравомуБорту = 0 Тогда
		ВсеИзвестны = Ложь;
		КНосу = Неопределено;
		ККорме = Неопределено;
		КЛевомуБорту = Неопределено;
		КПравомуБорту = Неопределено;
	ИначеЕсли ВсеИзвестны И КНосу = 0 И КЛевомуБорту = 0 И ККорме > 0 И КПравомуБорту > 0 Тогда
		// Размеры известны, положение антенны нет: B - длина, D - ширина, корпус центрируется на точке.
		КНосу = ККорме / 2;
		ККорме = КНосу;
		КЛевомуБорту = КПравомуБорту / 2;
		КПравомуБорту = КЛевомуБорту;
	КонецЕсли;

	Контракт.Вставить("toBow", КНосу);
	Контракт.Вставить("toStern", ККорме);
	Контракт.Вставить("toPort", КЛевомуБорту);
	Контракт.Вставить("toStarboard", КПравомуБорту);

	Длина = ПоложительноеИлиNull(ЧислоСвойства(Свойства, "length"));
	Ширина = ПоложительноеИлиNull(ЧислоСвойства(Свойства, "beam"));
	Если Длина = Неопределено И ВсеИзвестны Тогда
		Длина = ПоложительноеИлиNull(КНосу + ККорме);
	КонецЕсли;
	Если Ширина = Неопределено И ВсеИзвестны Тогда
		Ширина = ПоложительноеИлиNull(КЛевомуБорту + КПравомуБорту);
	КонецЕсли;
	Контракт.Вставить("length", Длина);
	Контракт.Вставить("beam", Ширина);

КонецПроцедуры

// Возвращаемое значение:
//  - Неопределено - координат нет или они вне допустимого диапазона.
//  - Массив из Число - [lon, lat].
Функция КоординатыОбъекта(Объект)

	Геометрия = Объект.Получить("geometry");
	Если ТипЗнч(Геометрия) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Координаты = Геометрия.Получить("coordinates");
	Если ТипЗнч(Координаты) <> Тип("Массив") Или Координаты.Количество() < 2
		Или ТипЗнч(Координаты[0]) <> Тип("Число") Или ТипЗнч(Координаты[1]) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Долгота = Координаты[0];
	Широта = Координаты[1];
	// Судно у края bbox или за ним оставляем: отбрасываем только невозможные координаты.
	Если Долгота < -180 Или Долгота > 180 Или Широта < -90 Или Широта > 90 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат МассивЧисел(Долгота, Широта);

КонецФункции

Функция АтрибуцияИсточников(Атрибуция, Источники)

	Если ТипЗнч(Атрибуция) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Тексты = Новый Массив;
	Для Каждого Источник Из Источники Цикл
		Текст = Атрибуция.Получить(Источник);
		Если ТипЗнч(Текст) = Тип("Строка") И ЗначениеЗаполнено(Текст) И Тексты.Найти(Текст) = Неопределено Тогда
			Тексты.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, " ");

КонецФункции

#КонецОбласти

#Область ЗаписьСнимка

Процедура ЗаписатьСнимок(Провайдер, ДатаПолучения, Разбор)

	Снимок = Новый Структура;
	Снимок.Вставить("contract", 1);
	Снимок.Вставить("provider", Провайдер);
	Снимок.Вставить("receivedAt", ДатаВISO(ДатаПолучения));
	Снимок.Вставить("freshestSeen",
		?(ЗначениеЗаполнено(Разбор.СамаяСвежаяПозиция), ДатаВISO(Разбор.СамаяСвежаяПозиция), Неопределено));
	Снимок.Вставить("bbox", ПараметрыРайона().bbox);
	Снимок.Вставить("attribution", Разбор.Атрибуция);
	Снимок.Вставить("vessels", Разбор.Суда);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Снимок);
	ДанныеJSON = Запись.Закрыть();

	// Пользователь карты только читает снимок; запись идёт от регламента или администратора.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Набор = РегистрыСведений.СнимкиAISV1.СоздатьНаборЗаписей();
		Набор.Отбор.Провайдер.Установить(Провайдер);
		Строка = Набор.Добавить();
		Строка.Провайдер = Провайдер;
		Строка.ДатаПолучения = ДатаПолучения;
		Строка.ДанныеJSON = ДанныеJSON;
		Строка.КоличествоСудов = Разбор.Суда.Количество();
		Строка.СамаяСвежаяПозиция = Разбор.СамаяСвежаяПозиция;
		Набор.Записать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура ЗаписатьВЖурнал(Уровень, Комментарий)

	// Тело ответа и токен в журнал не пишутся: только код состояния и представление ошибки.
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Подход судов.Получение AIS'", ОбщийКодЯзыка()),
		Уровень, Метаданные.ОбщиеМодули.ПолучениеДанныхAISV1, , Комментарий);

КонецПроцедуры

