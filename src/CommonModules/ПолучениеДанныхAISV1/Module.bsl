// Разбирает дату ISO 8601 в UTC: YYYY-MM-DDTHH:MM:SS, необязательные доли секунды, суффикс Z или +00:00.
// Разбор свой, а не ПрочитатьДатуJSON, чтобы результат не зависел от часового пояса компьютера.
//
// Возвращаемое значение:
//  - Неопределено - строка не разбирается или зона не UTC.
//  - Дата - дата UTC.
Функция ДатаИзISO(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) < 20 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Хвост = Сред(Значение, 20);
	Если Лев(Хвост, 1) = "." Тогда
		Позиция = 2;
		Пока Позиция <= СтрДлина(Хвост) И СтрНайти("0123456789", Сред(Хвост, Позиция, 1)) > 0 Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Хвост = Сред(Хвост, Позиция);
	КонецЕсли;
	Если Хвост <> "Z" И Хвост <> "+00:00" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Основа = Лев(Значение, 19);
	Если Сред(Основа, 5, 1) <> "-" Или Сред(Основа, 8, 1) <> "-" Или Сред(Основа, 11, 1) <> "T"
		Или Сред(Основа, 14, 1) <> ":" Или Сред(Основа, 17, 1) <> ":" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Цифры = Лев(Основа, 4) + Сред(Основа, 6, 2) + Сред(Основа, 9, 2)
		+ Сред(Основа, 12, 2) + Сред(Основа, 15, 2) + Сред(Основа, 18, 2);
	Попытка
		Возврат Дата(Цифры);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ДатаВISO(ДатаUTC)

	Возврат Формат(ДатаUTC, "ДФ=yyyy-MM-dd") + "T" + Формат(ДатаUTC, "ДФ=HH:mm:ss") + "Z";

КонецФункции

Функция ЧислоВСтроку(Число)

	Возврат Формат(Число, "ЧРД=.; ЧГ=0; ЧН=0");

КонецФункции

Функция МассивЧисел(Первое, Второе, Третье = Неопределено, Четвертое = Неопределено)

	Результат = Новый Массив;
	Результат.Добавить(Первое);
	Результат.Добавить(Второе);
	Если Третье <> Неопределено Тогда
		Результат.Добавить(Третье);
		Результат.Добавить(Четвертое);
	КонецЕсли;
	Возврат Результат;

КонецФункции

