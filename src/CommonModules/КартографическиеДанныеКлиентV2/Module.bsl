#Область Загрузка

// Кеш HTTP-соединений загрузки: одно соединение на хост и таймаут на весь набор.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ «хост|таймаут», значение HTTPСоединение.
Функция НовыеСоединения() Экспорт

	Возврат Новый Соответствие;

КонецФункции

// Скачивает ресурс набора строго одним запросом за раз; при 5xx, 429 и сетевой ошибке повторяет
// запрос дважды, затем переходит к следующему хосту из описания ресурса.
//
// Параметры:
//  Соединения - см. НовыеСоединения
//  Ресурс - Структура - описание ресурса из КартографическиеДанныеV2.НачальныеРесурсы / ОстальныеРесурсы:
//   * Ключ - Строка
//   * Хосты - Массив из Строка
//   * Путь - Строка
//   * Таймаут - Число
//   * Обязательный - Булево
//   * ПропуститьПриОшибке - Булево
//
// Возвращаемое значение:
//  Обещание - результат обещания - Структура:
//   * Статус - Строка - "ok", "empty" (204 или пустое тело), "missing" (404), "error";
//   * Тело - ДвоичныеДанные, Неопределено - тело ответа при "ok";
//   * Текст - Строка - описание ошибки.
Асинх Функция СкачатьАсинх(Соединения, Ресурс) Экспорт

	ТекстОшибки = "";
	Для Каждого Хост Из Ресурс.Хосты Цикл
		Для НомерПопытки = 1 По 3 Цикл
			Попытка
				Ответ = Ждать ЗапросАсинх(Соединение(Соединения, Хост, Ресурс.Таймаут), Ресурс.Путь);
			Исключение
				ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				Продолжить;
			КонецПопытки;

			Код = Ответ.КодСостояния;
			Если Код = 200 Тогда
				Тело = Ответ.ПолучитьТелоКакДвоичныеДанные();
				Если Тело = Неопределено Или Тело.Размер() = 0 Тогда
					Возврат РезультатСкачивания("empty");
				КонецЕсли;
				Если ЭтоGzip(Тело) Тогда
					// Встроенный HTTPСоединение gzip не распаковывает, а MapLibre 1.15 не читает сжатый protobuf.
					Возврат РезультатСкачивания("error", ,
						СтрШаблон(НСтр("ru = '%1: ответ сжат gzip, хотя запрошено Accept-Encoding: identity'"), Ресурс.Ключ));
				КонецЕсли;
				Возврат РезультатСкачивания("ok", Тело);
			ИначеЕсли Код = 204 Тогда
				Возврат РезультатСкачивания("empty");
			ИначеЕсли Код = 404 Тогда
				Возврат РезультатСкачивания("missing", , СтрШаблон("%1: HTTP 404", Ресурс.Ключ));
			ИначеЕсли Код = 301 Или Код = 302 Или (Код >= 400 И Код < 500 И Код <> 429) Тогда
				// Соединение по редиректу само не идёт, а тело редиректа - не ресурс; повтор не поможет.
				Возврат РезультатСкачивания("error", , СтрШаблон("%1: HTTP %2", Ресурс.Ключ, Код));
			КонецЕсли;
			ТекстОшибки = СтрШаблон("%1: HTTP %2 (%3)", Ресурс.Ключ, Код, Хост);
		КонецЦикла;
	КонецЦикла;
	Возврат РезультатСкачивания("error", , ТекстОшибки);

КонецФункции

// Текст ресурса в UTF-8 - для стилей и TileJSON, которые разбирает сервер.
//
// Параметры:
//  Тело - ДвоичныеДанные
//
// Возвращаемое значение:
//  Строка
Функция ТекстРесурса(Тело) Экспорт

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Тело, КодировкаТекста.UTF8);

КонецФункции

#КонецОбласти

#Область Пакеты

// Сборщик пакетов набора: ресурсы копятся до целевого размера и забираются одним текстом JSON.
//
// Параметры:
//  Набор - Строка - идентификатор набора;
//  ЦелевойРазмер - Число - размер пакета, символов.
//
// Возвращаемое значение:
//  Структура:
//   * Набор - Строка
//   * ЦелевойРазмер - Число
//   * Номер - Число - номер последнего выданного пакета;
//   * Элементы - Массив из Структура - ресурсы текущего пакета (k - ключ, b - base64);
//   * Размер - Число - символов в текущем пакете;
//   * Ресурсов - Число - ресурсов во всех пакетах;
//   * Байт - Число - объём ресурсов до base64.
Функция НовыйСборщик(Набор, ЦелевойРазмер) Экспорт

	Сборщик = Новый Структура;
	Сборщик.Вставить("Набор", Набор);
	Сборщик.Вставить("ЦелевойРазмер", ЦелевойРазмер);
	Сборщик.Вставить("Номер", 0);
	Сборщик.Вставить("Элементы", Новый Массив);
	Сборщик.Вставить("Размер", 0);
	Сборщик.Вставить("Ресурсов", 0);
	Сборщик.Вставить("Байт", 0);
	Возврат Сборщик;

КонецФункции

// Добавляет ресурс в текущий пакет.
//
// Параметры:
//  Сборщик - см. НовыйСборщик
//  Ключ - Строка - ключ ресурса;
//  Тело - ДвоичныеДанные - содержимое.
//
// Возвращаемое значение:
//  Булево - пакет набрал целевой размер, его пора забрать.
Функция ДобавитьРесурс(Сборщик, Ключ, Тело) Экспорт

	// Base64Строка вставляет перевод строки каждые 76 символов; переводы в пакете не нужны ни мосту, ни atob.
	Base64 = СтрЗаменить(СтрЗаменить(ПолучитьBase64СтрокуИзДвоичныхДанных(Тело), Символы.ВК, ""), Символы.ПС, "");
	Элемент = Новый Структура;
	Элемент.Вставить("k", Ключ);
	Элемент.Вставить("b", Base64);
	Сборщик.Элементы.Добавить(Элемент);
	Сборщик.Размер = Сборщик.Размер + СтрДлина(Base64) + СтрДлина(Ключ) + 16;
	Сборщик.Ресурсов = Сборщик.Ресурсов + 1;
	Сборщик.Байт = Сборщик.Байт + Тело.Размер();
	Возврат Сборщик.Размер >= Сборщик.ЦелевойРазмер;

КонецФункции

// Забирает текущий пакет текстом JSON {set, n, items} и начинает новый.
//
// Параметры:
//  Сборщик - см. НовыйСборщик
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если пакет пуст:
//   * Номер - Число
//   * Текст - Строка - JSON пакета;
//   * Количество - Число - ресурсов в пакете.
Функция ЗабратьПакет(Сборщик) Экспорт

	Если Сборщик.Элементы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сборщик.Номер = Сборщик.Номер + 1;
	Пакет = Новый Структура;
	Пакет.Вставить("set", Сборщик.Набор);
	Пакет.Вставить("n", Сборщик.Номер);
	Пакет.Вставить("items", Сборщик.Элементы);

	Результат = Новый Структура;
	Результат.Вставить("Номер", Сборщик.Номер);
	Результат.Вставить("Текст", ТекстJSON(Пакет));
	Результат.Вставить("Количество", Сборщик.Элементы.Количество());
	Сборщик.Элементы = Новый Массив;
	Сборщик.Размер = 0;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Соединение(Соединения, Хост, Таймаут)

	Ключ = Хост + "|" + Формат(Таймаут, "ЧГ=0");
	Соединение = Соединения.Получить(Ключ);
	Если Соединение = Неопределено Тогда
		Соединение = Новый HTTPСоединение(Хост, 443, , , Новый ИнтернетПрокси(Истина), Таймаут,
			Новый ЗащищенноеСоединениеOpenSSL);
		Соединения.Вставить(Ключ, Соединение);
	КонецЕсли;
	Возврат Соединение;

КонецФункции

Асинх Функция ЗапросАсинх(Соединение, Путь)

	Запрос = Новый HTTPЗапрос(Путь);
	// Без сжатия: OpenFreeMap и Overpass на identity отвечают несжатым телом (замер 17.10.2026).
	Запрос.Заголовки.Вставить("Accept-Encoding", "identity");
	Запрос.Заголовки.Вставить("User-Agent", "Harbor-1C/2");
	Возврат Ждать Соединение.ПолучитьАсинх(Запрос);

КонецФункции

Функция ЭтоGzip(Тело)

	Если Тело.Размер() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Тело);
	Возврат Буфер[0] = 31 И Буфер[1] = 139;

КонецФункции

Функция РезультатСкачивания(Статус, Тело = Неопределено, Текст = "")

	Результат = Новый Структура;
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("Тело", Тело);
	Результат.Вставить("Текст", Текст);
	Возврат Результат;

КонецФункции

Функция ТекстJSON(Значение)

#Если ВебКлиент Тогда
	// ЗаписьJSON в веб-клиенте нет; загрузка и диагностика набора работают только в тонком клиенте.
	ВызватьИсключение НСтр("ru = 'Пакеты набора собираются только в тонком клиенте'");
#Иначе
	// Без форматирования: отступы и переводы строк - лишние символы в каждом пакете моста.
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
#КонецЕсли

КонецФункции

#КонецОбласти
