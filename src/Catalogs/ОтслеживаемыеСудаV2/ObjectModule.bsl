#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если IMO = 0 И MMSI = 0 Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите IMO или MMSI судна'"), "IMO", Отказ);
	КонецЕсли;
	// Реквизиты - числа 7 и 9 разрядов; ведущих нулей у настоящих IMO и судовых MMSI нет.
	Если IMO <> 0 И IMO < 1000000 Тогда
		СообщитьОбОшибке(НСтр("ru = 'Номер IMO состоит из 7 цифр'"), "IMO", Отказ);
	КонецЕсли;
	Если MMSI <> 0 И MMSI < 100000000 Тогда
		СообщитьОбОшибке(НСтр("ru = 'MMSI состоит из 9 цифр'"), "MMSI", Отказ);
	КонецЕсли;

	Дубль = ДубльЭлемента();
	Если ЗначениеЗаполнено(Дубль) Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Это судно уже отслеживается: %1'"), Дубль), ?(IMO <> 0, "IMO", "MMSI"), Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Правка комментария автора и дату не меняет: их ставит только первая запись.
	Если ЭтоНовый() Тогда
		Добавил = ИмяПользователя();
		ДатаДобавления = ТекущаяУниверсальнаяДата();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Другой непомеченный элемент с тем же ненулевым IMO или тем же ненулевым MMSI. Незаполненный номер
// хранится нулём: условие без проверки на ноль совпало бы со всеми элементами без этого номера.
Функция ДубльЭлемента()

	Если IMO = 0 И MMSI = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Суда.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ОтслеживаемыеСудаV2 КАК Суда
		|ГДЕ
		|	Суда.Ссылка <> &Ссылка
		|	И НЕ Суда.ПометкаУдаления
		|	И (&IMO <> 0 И Суда.IMO = &IMO
		|		ИЛИ &MMSI <> 0 И Суда.MMSI = &MMSI)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("IMO", IMO);
	Запрос.УстановитьПараметр("MMSI", MMSI);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

Процедура СообщитьОбОшибке(Текст, Поле, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
