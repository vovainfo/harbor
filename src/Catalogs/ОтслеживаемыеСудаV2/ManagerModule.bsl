#Область ПрограммныйИнтерфейс

// Список отслеживаемых судов для карты. Версия - MD5 канонического массива: при неизменном списке она
// одна и та же, и такт опроса не пересылает список заново.
//
// Возвращаемое значение:
//  Структура:
//   * Версия - Строка - MD5 канонического JSON массива vessels (у пустого списка тоже есть версия);
//   * Текст - Строка - JSON {"version": …, "vessels": [{"imo", "mmsi", "name"}]}, номера - число или null.
Функция СписокДляКарты() Экспорт

	Запрос = Новый Запрос;
	// Стабильный порядок обязателен: от него зависит версия.
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Суда.IMO КАК IMO,
		|	Суда.MMSI КАК MMSI,
		|	Суда.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ОтслеживаемыеСудаV2 КАК Суда
		|ГДЕ
		|	НЕ Суда.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	IMO,
		|	MMSI,
		|	Наименование";
	Суда = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Судно = Новый Структура;
		Судно.Вставить("imo", ?(Выборка.IMO = 0, Неопределено, Выборка.IMO));
		Судно.Вставить("mmsi", ?(Выборка.MMSI = 0, Неопределено, Выборка.MMSI));
		Судно.Вставить("name", Выборка.Наименование);
		Суда.Добавить(Судно);
	КонецЦикла;

	Массив = ТекстJSON(Суда);
	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Массив);
	Версия = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

	Результат = Новый Структура;
	Результат.Вставить("Версия", Версия);
	Результат.Вставить("Текст", "{""version"":""" + Версия + """,""vessels"":" + Массив + "}");
	Возврат Результат;

КонецФункции

// Состояние отслеживания судна по правилу сопоставления: IMO, если он есть у обоих, иначе MMSI.
//
// Параметры:
//  MMSI - Число - MMSI судна;
//  IMO - Число, Неопределено - IMO судна; пустой - сопоставление только по MMSI.
//
// Возвращаемое значение:
//  Структура:
//   * Найден - Булево - судно отслеживается;
//   * Комментарий - Строка
//   * Добавил - Строка
//   * ДатаДобавления - Дата - UTC.
Функция Отслеживается(MMSI, IMO) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("Комментарий", "");
	Результат.Вставить("Добавил", "");
	Результат.Вставить("ДатаДобавления", Дата(1, 1, 1));
	Найденные = НайтиЭлементы(MMSI, IMO);
	Если Найденные.Количество() > 0 Тогда
		Результат.Найден = Истина;
		ЗаполнитьЗначенияСвойств(Результат, Найденные[0], "Комментарий, Добавил, ДатаДобавления");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Ставит судно на отслеживание. Найденный по правилу сопоставления элемент дополняется пустым номером
// и названием, а не дублируется: повтор из карточки и судно со сменившимся MMSI дают одну строку.
//
// Параметры:
//  MMSI - Число - MMSI судна;
//  IMO - Число, Неопределено - IMO судна;
//  Наименование - Строка - название судна.
//
// Возвращаемое значение:
//  см. Отслеживается
Функция Отслеживать(MMSI, IMO, Наименование) Экспорт

	Номер = ЧислоИлиНоль(IMO);
	Найденные = НайтиЭлементы(MMSI, IMO);
	Если Найденные.Количество() > 0 Тогда
		Объект = Найденные[0].Ссылка.ПолучитьОбъект();
	Иначе
		Объект = СоздатьЭлемент();
	КонецЕсли;
	Если Объект.IMO = 0 Тогда
		Объект.IMO = Номер;
	КонецЕсли;
	Если Объект.MMSI = 0 Тогда
		Объект.MMSI = ЧислоИлиНоль(MMSI);
	КонецЕсли;
	Если ЗначениеЗаполнено(Наименование) Тогда
		Объект.Наименование = Наименование;
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Наименование) Тогда
		Объект.Наименование = СтрШаблон("MMSI %1", Формат(Объект.MMSI, "ЧГ=0"));
	КонецЕсли;
	// Программная запись не вызывает ОбработкаПроверкиЗаполнения сама.
	Если Не Объект.ПроверитьЗаполнение() Тогда
		ВызватьИсключение НСтр("ru = 'Судно не поставлено на отслеживание: проверьте сообщения'");
	КонецЕсли;
	Объект.Записать();
	Возврат Отслеживается(MMSI, IMO);

КонецФункции

// Снимает судно с отслеживания: удаляет все элементы, которые правило сопоставления относит к судну
// (элемент «только IMO» и элемент «только MMSI» иначе оставили бы подсветку).
//
// Параметры:
//  MMSI - Число - MMSI судна;
//  IMO - Число, Неопределено - IMO судна.
//
// Возвращаемое значение:
//  см. Отслеживается
Функция НеОтслеживать(MMSI, IMO) Экспорт

	Для Каждого Найденный Из НайтиЭлементы(MMSI, IMO) Цикл
		Найденный.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;
	Возврат Отслеживается(MMSI, IMO);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Правило сопоставления (так же - isWatched во viewer): одинаковый IMO, а если IMO нет у одной из сторон - MMSI.
Функция НайтиЭлементы(MMSI, IMO)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Суда.Ссылка КАК Ссылка,
		|	Суда.Комментарий КАК Комментарий,
		|	Суда.Добавил КАК Добавил,
		|	Суда.ДатаДобавления КАК ДатаДобавления
		|ИЗ
		|	Справочник.ОтслеживаемыеСудаV2 КАК Суда
		|ГДЕ
		|	НЕ Суда.ПометкаУдаления
		|	И (&IMO <> 0 И Суда.IMO = &IMO
		|		ИЛИ &MMSI <> 0 И Суда.MMSI = &MMSI И (Суда.IMO = 0 ИЛИ &IMO = 0))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Суда.ДатаДобавления";
	Запрос.УстановитьПараметр("IMO", ЧислоИлиНоль(IMO));
	Запрос.УстановитьПараметр("MMSI", ЧислоИлиНоль(MMSI));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

Функция ТекстJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
