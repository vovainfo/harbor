#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = НСтр("ru = 'Диагностика HTML-поля'");
	HTML = Обработки.КартаПодходаСудов.СобратьHTMLДиагностики();
	Отчет = НСтр("ru = 'Диагностика выполняется...'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КартаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Href = "";
	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Href = Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;

	ПозицияСобытия = СтрНайти(Href, "#event:");
	Если ПозицияСобытия = 0 Тогда
		// Ссылки атрибуции пробной карты не должны открываться внутри поля.
		Если СтрНачинаетсяС(НРег(Href), "http") Тогда
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;

	Если Сред(Href, ПозицияСобытия + СтрДлина("#event:")) <> "diagnostics" Тогда
		Возврат;
	КонецЕсли;
	ТекстОтчета = АтрибутУзлаСобытия(ДанныеСобытия, "data-text");
	Если Не ПустаяСтрока(ТекстОтчета) Тогда
		Отчет = ТекстОтчета;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Атрибут узла, по которому кликнул JS (#map-event-bridge): отчёт лежит в его data-text.
&НаКлиенте
Функция АтрибутУзлаСобытия(ДанныеСобытия, ИмяАтрибута)

	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Узел = Неопределено;
	КонецПопытки;
	Попытка
		Если Узел = Неопределено Тогда
			Узел = ДанныеСобытия.Element;
		КонецЕсли;
		Значение = Узел.getAttribute(ИмяАтрибута);
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

#КонецОбласти
