#Область ОписаниеПеременных

// Отчёт страницы (data-text события diagnostics) и строки проверок формы - отчёт собирается из обоих.
&НаКлиенте
Перем ОтчетСтраницы;

&НаКлиенте
Перем ОтчетФормы;

&НаКлиенте
Перем ПроверкиФормыЗапущены;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = НСтр("ru = 'Диагностика HTML-поля (V2)'");
	HTML = Обработки.КартаПодходаСудовV2.СобратьHTMLДиагностики();
	Отчет = НСтр("ru = 'Диагностика выполняется...'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КартаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если Не ПустаяСтрока(МостКартыКлиентV2.ВнешняяСсылка(ДанныеСобытия)) Тогда
		// Ссылки атрибуции пробной карты не должны открываться внутри поля.
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	ТипСобытия = МостКартыКлиентV2.ТипСобытия(ДанныеСобытия);
	Если ПустаяСтрока(ТипСобытия) Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Если ТипСобытия <> "diagnostics" Тогда
		Возврат;
	КонецЕсли;

	ОтчетСтраницы = МостКартыКлиентV2.АтрибутУзлаСобытия(ДанныеСобытия, "data-text");
	ОбновитьОтчет();
	Если ПроверкиФормыЗапущены <> Истина Тогда
		ПроверкиФормыЗапущены = Истина;
		// Не внутри обработчика клика: проверки снова вызывают JS страницы.
		ПодключитьОбработчикОжидания("ЗапуститьПроверкиФормы", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапуститьПроверкиФормы()

	ВыполнитьПроверкиФормыАсинх();

КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьПроверкиФормыАсинх()

	ОтчетФормы = Новый Массив;
	Если ПроверитьМостБольшимиСтроками() Тогда
		Ждать ПроверитьТестовыйНабор();
	КонецЕсли;

КонецПроцедуры

#Область Мост

// Строки 0,5-4 МБ: порог моста задаёт размер пакета набора (КартографическиеДанныеV2.ПараметрыНабора).
// Следующий размер проверяется, только если прошёл меньший.
//
// Возвращаемое значение:
//  Булево - Ложь, если мост страницы не готов (библиотека не загрузилась).
&НаКлиенте
Функция ПроверитьМостБольшимиСтроками()

	ДобавитьВОтчет("== " + НСтр("ru = 'Мост 1С → страница большими строками'"));
	Для Каждого Мегабайт Из СтрРазделить("0.5,1,2,4", ",") Цикл
		Длина = Цел(Число(Мегабайт) * 1048576);
		Команда = "{""op"":""echo"",""text"":""" + СтрокаДлины(Длина) + """}";
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			Если Не МостКартыКлиентV2.ОтправитьКоманду(Элементы.Карта.Документ, Команда) Тогда
				ДобавитьВОтчет(НСтр("ru = 'мост страницы не готов - библиотека или общий код кеша не загрузились'"));
				Возврат Ложь;
			КонецЕсли;
		Исключение
			ДобавитьВОтчет(СтрШаблон(НСтр("ru = '%1 МБ: ошибка - %2'"), Мегабайт,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Возврат Истина;
		КонецПопытки;
		Время = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		Принято = МостКартыКлиентV2.РезультатКоманды(Элементы.Карта.Документ);
		Целиком = (Принято = Формат(Длина, "ЧГ=0"));
		ДобавитьВОтчет(СтрШаблон(НСтр("ru = '%1 МБ: %2, %3 мс'"), Мегабайт,
			?(Целиком, НСтр("ru = 'принято целиком'"), СтрШаблон(НСтр("ru = 'ПРИНЯТО %1 из %2 символов'"), Принято, Длина)),
			Время));
		Если Не Целиком Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция СтрокаДлины(Длина)

	Текст = "0123456789abcdef";
	Пока СтрДлина(Текст) < Длина Цикл
		Текст = Текст + Текст;
	КонецЦикла;
	Возврат Лев(Текст, Длина);

КонецФункции

#КонецОбласти

#Область ТестовыйНабор

// Маленький набор вокруг ВМКТ качается с клиента и упаковывается тем же кодом, что и полный набор:
// один прогон проверяет HTTPS клиента, base64 без переводов строк, мост, atob и harbor:// в V8WebKit.
&НаКлиенте
Асинх Функция ПроверитьТестовыйНабор()

	ДобавитьВОтчет("== " + НСтр("ru = 'Тестовый набор, скачанный с клиента'"));
	ПараметрыНабора = ПараметрыТестовогоНабора();
	Соединения = КартографическиеДанныеКлиентV2.НовыеСоединения();
	Сборщик = КартографическиеДанныеКлиентV2.НовыйСборщик("diagnostics", ПараметрыНабора.packageSize);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	ТекстыНачальных = Новый Соответствие;
	Для Каждого Ресурс Из НачальныеРесурсыНабора(ПараметрыНабора) Цикл
		Тело = Ждать СкачатьРесурсАсинх(Соединения, Ресурс);
		Если Тело = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ТекстыНачальных.Вставить(Ресурс.Ключ, КартографическиеДанныеКлиентV2.ТекстРесурса(Тело));
		КартографическиеДанныеКлиентV2.ДобавитьРесурс(Сборщик, Ресурс.Ключ, Тело);
	КонецЦикла;
	Пропущено = 0;
	Для Каждого Ресурс Из ОстальныеРесурсыНабора(ТекстыНачальных, ПараметрыНабора) Цикл
		Тело = Ждать СкачатьРесурсАсинх(Соединения, Ресурс);
		Если Тело = Неопределено Тогда
			Пропущено = Пропущено + 1;
		Иначе
			КартографическиеДанныеКлиентV2.ДобавитьРесурс(Сборщик, Ресурс.Ключ, Тело);
		КонецЕсли;
	КонецЦикла;
	ДобавитьВОтчет(СтрШаблон(НСтр("ru = 'Скачано ресурсов: %1 (%2 КБ), пропущено %3, %4 мс'"), Сборщик.Ресурсов,
		Формат(Сборщик.Байт / 1024, "ЧДЦ=0; ЧН=0"), Пропущено, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало));

	// Тестовый набор меньше целевого размера пакета - передаётся одним пакетом.
	Пакет = КартографическиеДанныеКлиентV2.ЗабратьПакет(Сборщик);
	Если Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ДобавитьВОтчет(СтрШаблон(НСтр("ru = 'Пакет: %1 символов, переводы строк в тексте: %2'"), Формат(СтрДлина(Пакет.Текст), "ЧГ=0"),
		?(СтрНайти(Пакет.Текст, Символы.ПС) = 0 И СтрНайти(Пакет.Текст, Символы.ВК) = 0, НСтр("ru = 'нет'"), НСтр("ru = 'ЕСТЬ'"))));
	Попытка
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		МостКартыКлиентV2.ОтправитьКоманду(Элементы.Карта.Документ,
			"{""op"":""addCachePackage"",""package"":" + Пакет.Текст + "}");
		ДобавитьВОтчет(СтрШаблон(НСтр("ru = 'Передача пакета через мост: %1 мс, ресурсов в кеше страницы: %2'"),
			ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, МостКартыКлиентV2.РезультатКоманды(Элементы.Карта.Документ)));
		// Итог пробной карты страница пришлёт новым отчётом (событие diagnostics).
		МостКартыКлиентV2.ОтправитьКоманду(Элементы.Карта.Документ, КомандаКартыИзКеша(ПараметрыНабора));
	Исключение
		ДобавитьВОтчет(СтрШаблон(НСтр("ru = 'Страница не приняла пакет: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Возвращаемое значение:
//  Обещание - результат - ДвоичныеДанные; Неопределено, если ресурс не получен (обязательный - с записью в отчёт).
&НаКлиенте
Асинх Функция СкачатьРесурсАсинх(Соединения, Ресурс)

	Результат = Ждать КартографическиеДанныеКлиентV2.СкачатьАсинх(Соединения, Ресурс);
	Если Результат.Статус = "ok" Тогда
		Возврат Результат.Тело;
	КонецЕсли;
	Если Ресурс.Обязательный Или Результат.Статус = "error" Тогда
		ДобавитьВОтчет(СтрШаблон(НСтр("ru = 'Не получен %1: %2'"), Ресурс.Ключ, Результат.Текст));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Команда собирается на сервере: ЗаписьJSON нет в веб-клиенте.
&НаСервереБезКонтекста
Функция КомандаКартыИзКеша(ПараметрыНабора)

	Команда = Новый Структура;
	Команда.Вставить("op", "protocolMap");
	Команда.Вставить("minZoom", ПараметрыНабора.minZoom);
	Команда.Вставить("bbox", ПараметрыНабора.bbox);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Команда);
	Возврат Запись.Закрыть();

КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыТестовогоНабора()

	Возврат КартографическиеДанныеV2.ПараметрыДиагностики();

КонецФункции

&НаСервереБезКонтекста
Функция НачальныеРесурсыНабора(ПараметрыНабора)

	Возврат КартографическиеДанныеV2.НачальныеРесурсы(ПараметрыНабора);

КонецФункции

&НаСервереБезКонтекста
Функция ОстальныеРесурсыНабора(ТекстыНачальных, ПараметрыНабора)

	Возврат КартографическиеДанныеV2.ОстальныеРесурсы(ТекстыНачальных, ПараметрыНабора);

КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ДобавитьВОтчет(Строка)

	ОтчетФормы.Добавить("  " + Строка);
	ОбновитьОтчет();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтчет()

	Части = Новый Массив;
	Если Не ПустаяСтрока(ОтчетСтраницы) Тогда
		Части.Добавить(ОтчетСтраницы);
	КонецЕсли;
	Если ОтчетФормы <> Неопределено И ОтчетФормы.Количество() > 0 Тогда
		Части.Добавить(НСтр("ru = 'Проверки формы:'") + Символы.ПС + СтрСоединить(ОтчетФормы, Символы.ПС));
	КонецЕсли;
	Отчет = СтрСоединить(Части, Символы.ПС);

КонецПроцедуры

#КонецОбласти
