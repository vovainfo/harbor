#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСведения(Параметры.MMSI);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Карта получает новый список оповещением: её форма своего серверного вызова не делает.
&НаКлиенте
Процедура Отслеживать(Команда)

	Оповестить(МостКартыКлиентV2.СобытиеСпискаОтслеживаемых(), ПереключитьОтслеживание());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Показывает в открытой карточке другое судно: повторное «Подробнее» на карте не открывает новую форму.
//
// Параметры:
//  НовыйMMSI - Число - MMSI судна.
&НаКлиенте
Процедура ПоказатьСудно(НовыйMMSI) Экспорт

	ЗаполнитьСведения(НовыйMMSI);

КонецПроцедуры

// Сведения - из последнего снимка AIS V2 на сервере; позже сюда добавятся рейсы ЕДС по IMO.
// Состояние отслеживания считается в обеих ветках: и при повторном «Подробнее», и для судна не из снимка.
&НаСервере
Процедура ЗаполнитьСведения(НовыйMMSI)

	MMSI = НовыйMMSI;
	Найденное = ПолучениеДанныхAISV2.СудноИзПоследнегоСнимка(MMSI);
	Если Не Найденное.Найдено Тогда
		Заголовок = СтрШаблон(НСтр("ru = 'Судно MMSI %1'"), Формат(MMSI, "ЧГ=0"));
		Сведения = НСтр("ru = 'Судна нет в последнем снимке AIS: позиция устарела или судно вышло из района.'");
		ПоказатьОтслеживание(Неопределено);
		Возврат;
	КонецЕсли;

	Судно = Найденное.Судно;
	Имя = Судно.Получить("name");
	Заголовок = ?(ЗначениеЗаполнено(Имя), Имя, СтрШаблон(НСтр("ru = 'Судно MMSI %1'"), Формат(MMSI, "ЧГ=0")));

	Строки = Новый Массив;
	ДобавитьСтроку(Строки, НСтр("ru = 'Название'"), Имя);
	ДобавитьСтроку(Строки, "MMSI", Формат(MMSI, "ЧГ=0"));
	ДобавитьСтроку(Строки, "IMO", ЧислоСтрокой(Судно.Получить("imo"), 0));
	ДобавитьСтроку(Строки, НСтр("ru = 'Позывной'"), Судно.Получить("callsign"));
	ДобавитьСтроку(Строки, НСтр("ru = 'Флаг'"), Судно.Получить("flag"));
	ДобавитьСтроку(Строки, НСтр("ru = 'Тип судна (код AIS)'"), ЧислоСтрокой(Судно.Получить("shipType"), 0));
	ДобавитьСтроку(Строки, НСтр("ru = 'Навигационный статус (код AIS)'"), ЧислоСтрокой(Судно.Получить("navStatus"), 0));
	ДобавитьСтроку(Строки, НСтр("ru = 'Координаты (lat, lon)'"),
		ЧислоСтрокой(Судно.Получить("lat"), 5) + ", " + ЧислоСтрокой(Судно.Получить("lon"), 5));
	ДобавитьСтроку(Строки, НСтр("ru = 'Скорость, уз'"), ЧислоСтрокой(Судно.Получить("sog"), 1));
	ДобавитьСтроку(Строки, НСтр("ru = 'Курс COG / HDG, °'"),
		ЧислоСтрокой(Судно.Получить("cog"), 0) + " / " + ЧислоСтрокой(Судно.Получить("heading"), 0));
	ДобавитьСтроку(Строки, НСтр("ru = 'Длина × ширина, м'"),
		ЧислоСтрокой(Судно.Получить("length"), 0) + " × " + ЧислоСтрокой(Судно.Получить("beam"), 0));
	ДобавитьСтроку(Строки, НСтр("ru = 'Осадка, м'"), ЧислоСтрокой(Судно.Получить("draught"), 1));
	ДобавитьСтроку(Строки, НСтр("ru = 'Назначение'"), Судно.Получить("destination"));
	ДобавитьСтроку(Строки, НСтр("ru = 'ETA (UTC)'"), Судно.Получить("eta"));
	ДобавитьСтроку(Строки, НСтр("ru = 'Позиция от (UTC)'"), Судно.Получить("seen"));
	ДобавитьСтроку(Строки, НСтр("ru = 'Снимок от (UTC)'"), Формат(Найденное.ДатаПолучения, "ДФ='dd.MM.yyyy HH:mm:ss'"));
	ДобавитьСтроку(Строки, НСтр("ru = 'Источник'"), Судно.Получить("source"));
	Сведения = СтрСоединить(Строки, Символы.ПС);
	ПоказатьОтслеживание(Судно.Получить("imo"));

КонецПроцедуры

// Параметры:
//  IMO - Число, Неопределено - IMO судна из снимка; пустой - сопоставление только по MMSI.
&НаСервере
Процедура ПоказатьОтслеживание(IMO)

	Состояние = Справочники.ОтслеживаемыеСудаV2.Отслеживается(MMSI, IMO);
	Элементы.Отслеживать.Заголовок = ?(Состояние.Найден, НСтр("ru = 'Не отслеживать'"), НСтр("ru = 'Отслеживать'"));
	Если Не Состояние.Найден Тогда
		Отслеживание = НСтр("ru = 'Не отслеживается'");
		Возврат;
	КонецЕсли;
	// Дата хранится в UTC, показывается местным временем сеанса, как строка состояния карты.
	Отслеживание = СтрШаблон(НСтр("ru = 'Отслеживается с %1 (добавил %2)'"),
		Формат(МестноеВремя(Состояние.ДатаДобавления, ЧасовойПоясСеанса()), "ДФ='dd.MM.yyyy HH:mm'"),
		?(ЗначениеЗаполнено(Состояние.Добавил), Состояние.Добавил, "-"));
	Если ЗначениеЗаполнено(Состояние.Комментарий) Тогда
		Отслеживание = Отслеживание + Символы.ПС + Состояние.Комментарий;
	КонецЕсли;

КонецПроцедуры

// IMO и название - из снимка, если судно в нём есть; иначе только MMSI формы.
//
// Возвращаемое значение:
//  см. Обработки.КартаПодходаСудовV2.КомандаСпискаОтслеживаемых
&НаСервере
Функция ПереключитьОтслеживание()

	Найденное = ПолучениеДанныхAISV2.СудноИзПоследнегоСнимка(MMSI);
	IMO = ?(Найденное.Найдено, Найденное.Судно.Получить("imo"), Неопределено);
	Имя = ?(Найденное.Найдено, Найденное.Судно.Получить("name"), "");
	Если Справочники.ОтслеживаемыеСудаV2.Отслеживается(MMSI, IMO).Найден Тогда
		Справочники.ОтслеживаемыеСудаV2.НеОтслеживать(MMSI, IMO);
	Иначе
		Справочники.ОтслеживаемыеСудаV2.Отслеживать(MMSI, IMO, Имя);
	КонецЕсли;
	ПоказатьОтслеживание(IMO);
	Возврат Обработки.КартаПодходаСудовV2.КомандаСпискаОтслеживаемых();

КонецФункции

&НаСервере
Процедура ДобавитьСтроку(Строки, Подпись, Значение)

	Строки.Добавить(Подпись + ": " + ?(ЗначениеЗаполнено(Значение), Значение, "-"));

КонецПроцедуры

// Поля контракта бывают null: прочерк вместо пустой строки или нуля.
&НаСервере
Функция ЧислоСтрокой(Значение, Разрядов)

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат "-";
	КонецЕсли;
	Возврат Формат(Значение, СтрШаблон("ЧДЦ=%1; ЧРД=.; ЧГ=0; ЧН=0", Разрядов));

КонецФункции

#КонецОбласти
