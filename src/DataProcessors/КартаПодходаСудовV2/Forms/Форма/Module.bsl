#Область ОписаниеПеременных

// Очередь команд, которые мост карты ещё не принял: отправляется с головы, хвост ждёт следующего такта.
// Одна строка затирала бы команду командой (startMap - setWatchlist, updateVessels - startMap).
&НаКлиенте
Перем ОжидающиеКомандыКарты;

// Состояние переноса кеша в HTML-поле: Набор, Всего, Следующий, Остановлен.
&НаКлиенте
Перем ПереносКеша;

// Открытая карточка судна: повторное «Подробнее» меняет судно в ней, а не открывает новую.
&НаКлиенте
Перем КарточкаСудна;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = НСтр("ru = 'Карта подхода судов'");
	МожноМенятьСнимок = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.СнимкиAISV2);
	Элементы.ПолучитьДанныеСейчас.Видимость = МожноМенятьСнимок;
	Элементы.ЗагрузитьСнимокИзФайла.Видимость = МожноМенятьСнимок;
	Элементы.ЗагрузитьСнимокИзМакета.Видимость = МожноМенятьСнимок;
	Элементы.ЗагрузкаКарты.Видимость = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.НаборыКартыV2);

	Сборка = Обработки.КартаПодходаСудовV2.СобратьHTMLКарты();
	HTML = Сборка.HTML;
	ДатаСнимка = Сборка.ДатаПолучения;
	ВерсияСписка = Сборка.ВерсияСписка;
	Состояние = Сборка.Состояние;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОжидающиеКомандыКарты = Новый Массив;
	ПереносКеша = Неопределено;
	ПодключитьОбработчикОжидания("ОбновитьКартуПоТакту", ПериодОпросаСекунд(), Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	// Отложенный шаг переноса может сработать уже после закрытия - он проверит этот флаг.
	Если ПереносКеша <> Неопределено Тогда
		ПереносКеша.Остановлен = Истина;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ОбновитьКартуПоТакту");

КонецПроцедуры

// Карточка судна сообщает новый список отслеживаемых судов готовой командой: своего серверного вызова
// форма карты не делает, версия запоминается, чтобы такт не прислал тот же список повторно.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия <> МостКартыКлиентV2.СобытиеСпискаОтслеживаемых() Тогда
		Возврат;
	КонецЕсли;
	ВерсияСписка = Параметр.Версия;
	ОтправитьКомандуКарте(Параметр.ТекстКоманды, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КартаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = МостКартыКлиентV2.ВнешняяСсылка(ДанныеСобытия);
	Если Не ПустаяСтрока(Ссылка) Тогда
		// Ссылки атрибуции открываются в браузере, а не внутри поля карты.
		СтандартнаяОбработка = Ложь;
		ПерейтиПоНавигационнойСсылке(Ссылка);
		Возврат;
	КонецЕсли;

	ТипСобытия = МостКартыКлиентV2.ТипСобытия(ДанныеСобытия);
	Если ПустаяСтрока(ТипСобытия) Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Сообщение = МостКартыКлиентV2.АтрибутУзлаСобытия(ДанныеСобытия, "data-message");

	Если ТипСобытия = "ready" Тогда
		// Перенос мог уже начаться по запасному запросу status на такте опроса.
		Если ПереносКеша = Неопределено Тогда
			НачатьПереносКеша(Сообщение);
		КонецЕсли;
	ИначеЕсли ТипСобытия = "error" Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Карта: %1'"), Сообщение);
	ИначеЕсли ТипСобытия = "vessel" Тогда
		ОткрытьКарточкуСудна(Сообщение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПолучитьДанныеСейчас(Команда)

	ПоказатьРезультатОбновления(ПолучитьДанныеСейчасНаСервере(ДатаСнимка, ВерсияСписка));

КонецПроцедуры

// Сохранённый ответ Open Waters (GeoJSON) - для показа, когда источник временно не отдаёт суда района.
&НаКлиенте
Асинх Процедура ЗагрузитьСнимокИзФайла(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов(НСтр("ru = 'Сохранённый ответ Open Waters'"), Ложь,
		НСтр("ru = 'Ответ Open Waters (GeoJSON)'") + "|*.json;*.geojson");
	Файл = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);
	Если Файл = Неопределено Или Файл.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьРезультатОбновления(ЗагрузитьСнимокНаСервере(Файл.Адрес, ДатаСнимка, ВерсияСписка));

КонецПроцедуры

// Ответ Open Waters от 17.10.2026 (118 судов в акватории подходов), сохранённый в макете обработки.
&НаКлиенте
Процедура ЗагрузитьСнимокИзМакета(Команда)

	ПоказатьРезультатОбновления(ЗагрузитьСнимокИзМакетаНаСервере(ДатаСнимка, ВерсияСписка));

КонецПроцедуры

// Изменения списка доходят до карты на ближайшем такте опроса.
&НаКлиенте
Процедура ОтслеживаемыеСуда(Команда)

	ОткрытьФорму("Справочник.ОтслеживаемыеСудаV2.ФормаСписка", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаКарты(Команда)

	ОткрытьФорму("Обработка.КартаПодходаСудовV2.Форма.ЗагрузкаКарты", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Диагностика(Команда)

	ОткрытьФорму("Обработка.КартаПодходаСудовV2.Форма.Диагностика", , ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПереносКеша

// Страница сообщает в ready «<идентификатор набора>|<число пакетов>»; пустой идентификатор - набора нет.
&НаКлиенте
Процедура НачатьПереносКеша(Сообщение)

	Части = СтрРазделить(Сообщение, "|");
	ПереносКеша = Новый Структура;
	ПереносКеша.Вставить("Набор", ?(Части.Количество() > 0, Части[0], ""));
	ПереносКеша.Вставить("Всего", ?(Части.Количество() > 1 И Не ПустаяСтрока(Части[1]), Число(Части[1]), 0));
	ПереносКеша.Вставить("Следующий", 1);
	ПереносКеша.Вставить("Остановлен", Ложь);
	// Не внутри обработчика клика карты: команды снова вызывают JS, пусть стек событий сначала завершится.
	ПодключитьОбработчикОжидания("ШагПереносаКеша", 0.1, Истина);

КонецПроцедуры

// Один шаг - один серверный вызов на несколько пакетов. Между шагами поле перерисовывает индикатор,
// а опрос и кнопки формы остаются живыми; синхронный цикл заморозил бы и то, и другое.
&НаКлиенте
Процедура ШагПереносаКеша()

	Если ПереносКеша = Неопределено Или ПереносКеша.Остановлен Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ПереносКеша.Набор) Или ПереносКеша.Следующий > ПереносКеша.Всего Тогда
		ЗавершитьПереносКеша();
		Возврат;
	КонецЕсли;

	НомерПо = Мин(ПереносКеша.Следующий + ПакетовЗаШаг() - 1, ПереносКеша.Всего);
	Пакеты = ПакетыКарты(ПереносКеша.Набор, ПереносКеша.Следующий, НомерПо);
	Если Пакеты.Количество() = 0 Тогда
		ПереносКеша.Остановлен = Истина;
		Состояние = НСтр("ru = 'Набор картографических данных сменился во время загрузки. Откройте карту заново'");
		Возврат;
	КонецЕсли;
	Попытка
		Для Каждого Пакет Из Пакеты Цикл
			// Строка пакета вставляется в команду без разбора: она идёт в атрибут моста, а не в <script>.
			ОтправитьКомандуКарте("{""op"":""addCachePackage"",""package"":" + Пакет + "}", Ложь);
		КонецЦикла;
	Исключение
		ПереносКеша.Остановлен = Истина;
		Состояние = СтрШаблон(НСтр("ru = 'Карта не приняла данные: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	ПереносКеша.Следующий = НомерПо + 1;
	ПодключитьОбработчикОжидания("ШагПереносаКеша", 0.1, Истина);

КонецПроцедуры

// Запасной путь, если событие ready до 1С не дошло: страница отвечает на status тем же текстом.
&НаКлиенте
Процедура ЗапроситьСостояниеСтраницы()

	Попытка
		ОтправитьКомандуКарте("{""op"":""status""}", Ложь);
	Исключение
		// Мост ещё не готов - спросим на следующем такте.
		Возврат;
	КонецПопытки;
	НачатьПереносКеша(МостКартыКлиентV2.РезультатКоманды(Элементы.Карта.Документ));

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПереносКеша()

	ПереносКеша.Остановлен = Истина;
	ОтправитьКомандуКарте("{""op"":""startMap""}", Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПакетыКарты(Набор, НомерС, НомерПо)

	Возврат КартографическиеДанныеV2.ПакетыНабора(Набор, НомерС, НомерПо);

КонецФункции

&НаКлиенте
Функция ПакетовЗаШаг()

	// Около 4 МБ за серверный вызов при пакете 1,5 МБ.
	Возврат 2;

КонецФункции

#КонецОбласти

#Область Суда

&НаКлиенте
Процедура ОбновитьКартуПоТакту()

	Если ПереносКеша = Неопределено Тогда
		ЗапроситьСостояниеСтраницы();
	КонецЕсли;
	ОтправитьОжидающиеКоманды();
	ПрименитьОбновление(ОбновлениеКарты(ДатаСнимка, ВерсияСписка));

КонецПроцедуры

// Серверные вызовы без контекста: иначе на каждом такте туда и обратно передавался бы мегабайт HTML формы.
&НаСервереБезКонтекста
Функция ОбновлениеКарты(ИзвестнаяДата, ИзвестнаяВерсияСписка)

	Возврат Обработки.КартаПодходаСудовV2.ОбновлениеКарты(ИзвестнаяДата, ИзвестнаяВерсияСписка);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеСейчасНаСервере(ИзвестнаяДата, ИзвестнаяВерсияСписка)

	ПроверитьПравоИзмененияСнимка();
	Возврат РезультатКомандыСнимка(ПолучениеДанныхAISV2.ОбновитьСнимокOpenWaters(), ИзвестнаяДата, ИзвестнаяВерсияСписка);

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьСнимокНаСервере(Адрес, ИзвестнаяДата, ИзвестнаяВерсияСписка)

	ПроверитьПравоИзмененияСнимка();
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Возврат РезультатКомандыСнимка(ПолучениеДанныхAISV2.ЗагрузитьСнимокOpenWatersИзТекста(Текст),
		ИзвестнаяДата, ИзвестнаяВерсияСписка);

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьСнимокИзМакетаНаСервере(ИзвестнаяДата, ИзвестнаяВерсияСписка)

	ПроверитьПравоИзмененияСнимка();
	Текст = Обработки.КартаПодходаСудовV2.ПолучитьМакет("СохраненныйОтветOpenWaters").ПолучитьТекст();
	Возврат РезультатКомандыСнимка(ПолучениеДанныхAISV2.ЗагрузитьСнимокOpenWatersИзТекста(Текст),
		ИзвестнаяДата, ИзвестнаяВерсияСписка);

КонецФункции

// Команды скрыты без права, проверка здесь - на случай вызова в обход интерфейса.
&НаСервереБезКонтекста
Процедура ПроверитьПравоИзмененияСнимка()

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.СнимкиAISV2) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для обновления снимка AIS'");
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  РезультатОбновления - см. ПолучениеДанныхAISV2.ОбновитьСнимокOpenWaters
//  ИзвестнаяДата - Дата - дата снимка на карте, UTC;
//  ИзвестнаяВерсияСписка - Строка - версия списка отслеживаемых судов на карте.
//
// Возвращаемое значение:
//  Структура - РезультатОбновления и поле Обновление (см. Обработки.КартаПодходаСудовV2.ОбновлениеКарты),
//    Неопределено, если снимок не записан.
&НаСервереБезКонтекста
Функция РезультатКомандыСнимка(РезультатОбновления, ИзвестнаяДата, ИзвестнаяВерсияСписка)

	РезультатОбновления.Вставить("Обновление", Неопределено);
	Если РезультатОбновления.Записан Тогда
		РезультатОбновления.Обновление = Обработки.КартаПодходаСудовV2.ОбновлениеКарты(ИзвестнаяДата,
			ИзвестнаяВерсияСписка);
	КонецЕсли;
	Возврат РезультатОбновления;

КонецФункции

// Параметры:
//  Результат - см. РезультатКомандыСнимка
&НаКлиенте
Процедура ПоказатьРезультатОбновления(Результат)

	Если Не Результат.Успешно Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Ошибка получения данных: %1'"), Результат.ТекстОшибки);
		СообщитьПользователю(Состояние);
		Возврат;
	КонецЕсли;
	Если Не Результат.Записан Тогда
		СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Снимок не изменён: в ответе Open Waters слишком мало судов (%1), показан прежний снимок'"),
			Результат.КоличествоСудов));
		Возврат;
	КонецЕсли;
	ПрименитьОбновление(Результат.Обновление);
	СообщитьПользователю(СтрШаблон(НСтр("ru = 'Снимок обновлён: принято судов %1, пропущено %2'"),
		Результат.КоличествоСудов, Результат.Пропущено));

КонецПроцедуры

// Параметры:
//  Обновление - см. Обработки.КартаПодходаСудовV2.ОбновлениеКарты
&НаКлиенте
Процедура ПрименитьОбновление(Обновление)

	Состояние = Обновление.Состояние;
	ДатаСнимка = Обновление.ДатаПолучения;
	ВерсияСписка = Обновление.ВерсияСписка;
	Для Каждого ТекстКоманды Из Обновление.Команды Цикл
		ОтправитьКомандуКарте(ТекстКоманды, Истина);
	КонецЦикла;

КонецПроцедуры

// MMSI приходит из data-message строкой, в контракте судна это число.
&НаКлиенте
Процедура ОткрытьКарточкуСудна(Сообщение)

	Попытка
		MMSI = Число(Сообщение);
	Исключение
		Возврат;
	КонецПопытки;
	Если КарточкаСудна <> Неопределено И КарточкаСудна.Открыта() Тогда
		// Новый ОткрытьФорму показал бы уже открытую форму без повторного ПриСозданииНаСервере.
		КарточкаСудна.ПоказатьСудно(MMSI);
		КарточкаСудна.Активизировать();
		Возврат;
	КонецЕсли;
	КарточкаСудна = ОткрытьФорму("Обработка.КартаПодходаСудовV2.Форма.КарточкаСудна",
		Новый Структура("MMSI", MMSI), ЭтотОбъект, Новый УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область Мост

// Отправляет очередь с головы по одной команде: страница делает один JSON.parse на клик.
// Мост не готов - хвост, начиная с этой команды, ждёт следующего такта. Страница отвергла команду -
// снимается только она, текст ошибки - в состояние, следующие отправляются.
&НаКлиенте
Процедура ОтправитьОжидающиеКоманды()

	Пока ОжидающиеКомандыКарты.Количество() > 0 Цикл
		Попытка
			Принята = МостКартыКлиентV2.ОтправитьКоманду(Элементы.Карта.Документ, ОжидающиеКомандыКарты[0]);
		Исключение
			ОжидающиеКомандыКарты.Удалить(0);
			Состояние = СтрШаблон(НСтр("ru = 'Карта не приняла данные: %1'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если Не Принята Тогда
			Возврат;
		КонецЕсли;
		ОжидающиеКомандыКарты.Удалить(0);
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  ТекстКоманды - Строка - JSON команды;
//  ОтложитьПриОтказе - Булево - Истина: команда встаёт в очередь (см. ОтправитьОжидающиеКоманды);
//    Ложь: отправляется сразу, отказ или ошибка возвращаются вызывающему исключением (пакеты кеша).
&НаКлиенте
Процедура ОтправитьКомандуКарте(ТекстКоманды, ОтложитьПриОтказе)

	Если Не ОтложитьПриОтказе Тогда
		Если Не МостКартыКлиентV2.ОтправитьКоманду(Элементы.Карта.Документ, ТекстКоманды) Тогда
			ВызватьИсключение НСтр("ru = 'Мост карты не готов'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ОжидающиеКомандыКарты.Добавить(ТекстКоманды);
	ОтправитьОжидающиеКоманды();

КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура СообщитьПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

&НаКлиенте
Функция ПериодОпросаСекунд()

	Возврат 30;

КонецФункции

#КонецОбласти
