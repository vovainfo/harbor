#Область ОписаниеПеременных

// Состояние загрузки: Идет, Отмена, ЗакрытьПослеОтмены, Набор, Начало (мс); Неопределено - загрузка не начиналась.
&НаКлиенте
Перем Загрузка;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = НСтр("ru = 'Загрузка картографических данных'");
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.НаборыКартыV2) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ОписаниеНабора = ОписаниеПараметров(КартографическиеДанныеV2.ПараметрыНабора());
	Ход = НСтр("ru = 'Загрузка идёт с этого компьютера: нужен доступ к tiles.openfreemap.org и Overpass API.
		|Полная загрузка - тысячи последовательных запросов, порядка 5-15 минут.'");

КонецПроцедуры

// Асинх-цикл загрузки продолжил бы работать на закрытой форме и упал на обращении к элементам:
// закрыть форму можно только через отмену, цикл сам закроет её после ОтменитьНабор.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Загрузка = Неопределено Или Не Загрузка.Идет Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Идёт загрузка картографических данных'");
		Возврат;
	КонецЕсли;
	Загрузка.Отмена = Истина;
	Загрузка.ЗакрытьПослеОтмены = Истина;
	ДобавитьВХод(НСтр("ru = 'Отмена загрузки...'"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Начать(Команда)

	Если Загрузка <> Неопределено И Загрузка.Идет Тогда
		Возврат;
	КонецЕсли;
#Если ВебКлиент Тогда
	ПоказатьПредупреждение(, НСтр("ru = 'Загрузка доступна только в тонком клиенте'"));
#Иначе
	ЗагрузитьНаборАсинх();
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)

	Если Загрузка <> Неопределено И Загрузка.Идет И Не Загрузка.Отмена Тогда
		Загрузка.Отмена = Истина;
		ДобавитьВХод(НСтр("ru = 'Отмена загрузки...'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Асинх Процедура ЗагрузитьНаборАсинх()

	Загрузка = Новый Структура;
	Загрузка.Вставить("Идет", Истина);
	Загрузка.Вставить("Отмена", Ложь);
	Загрузка.Вставить("ЗакрытьПослеОтмены", Ложь);
	Загрузка.Вставить("Набор", "");
	Загрузка.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Элементы.Начать.Доступность = Ложь;
	Ход = "";
	Попытка
		Начатый = НачатьНаборНаСервере();
		Загрузка.Набор = Начатый.Набор;
		ДобавитьВХод(СтрШаблон(НСтр("ru = 'Набор %1: скачивание стилей и TileJSON'"), Начатый.Набор));
		Манифест = Ждать СкачатьИЗаписатьНаборАсинх(Начатый.Набор, Начатый.Параметры);
		Если Манифест = Неопределено Тогда
			ОтменитьНаборНаСервере(Начатый.Набор);
			ДобавитьВХод(НСтр("ru = 'Загрузка отменена, прежний набор остался активным'"));
		Иначе
			ЗавершитьНаборНаСервере(Начатый.Набор, Манифест);
			ДобавитьВХод(СтрШаблон(НСтр("ru = 'Готово: ресурсов %1, пропущено %2, %3 МБ, пакетов %4, %5. Набор активен - откройте карту заново'"),
				Манифест.Ресурсов, Манифест.Пропущено, Формат(Манифест.Байт / 1048576, "ЧДЦ=1"), Манифест.Пакетов,
				ПредставлениеДлительности(ТекущаяУниверсальнаяДатаВМиллисекундах() - Загрузка.Начало)));
		КонецЕсли;
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Не ПустаяСтрока(Загрузка.Набор) Тогда
			Попытка
				ОтменитьНаборНаСервере(Загрузка.Набор);
			Исключение
				// Брошенный набор уберёт следующий НачатьНабор; здесь важнее показать исходную ошибку.
				ТекстОшибки = ТекстОшибки + Символы.ПС
					+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
		КонецЕсли;
		ДобавитьВХод(СтрШаблон(НСтр("ru = 'Ошибка загрузки, прежний набор остался активным: %1'"), ТекстОшибки));
	КонецПопытки;

	Загрузка.Идет = Ложь;
	Элементы.Начать.Доступность = Истина;
	Если Загрузка.ЗакрытьПослеОтмены Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

// Скачивает ресурсы строго по одному: каждое Ждать отпускает интерфейс, флаг отмены проверяется
// на каждой итерации. Ошибка обязательного ресурса прерывает загрузку исключением.
//
// Возвращаемое значение:
//  Структура, Неопределено - манифест для КартографическиеДанныеV2.ЗавершитьНабор; Неопределено при отмене.
&НаКлиенте
Асинх Функция СкачатьИЗаписатьНаборАсинх(Набор, ПараметрыНабора)

	Соединения = КартографическиеДанныеКлиентV2.НовыеСоединения();
	Сборщик = КартографическиеДанныеКлиентV2.НовыйСборщик(Набор, ПараметрыНабора.packageSize);
	// Сборщик - в счётчиках, чтобы прогресс показывал переданные пакеты и объём.
	Счетчики = Новый Структура;
	Счетчики.Вставить("Скачано", 0);
	Счетчики.Вставить("Всего", 0);
	Счетчики.Вставить("Пропущено", 0);
	Счетчики.Вставить("Сборщик", Сборщик);

	Начальные = НачальныеРесурсыНабора(ПараметрыНабора);
	Счетчики.Всего = Начальные.Количество();
	ТекстыНачальных = Новый Соответствие;
	Для Каждого Ресурс Из Начальные Цикл
		Тело = Ждать СкачатьРесурсАсинх(Соединения, Ресурс, Счетчики);
		Если Загрузка.Отмена Тогда
			Возврат Неопределено;
		КонецЕсли;
		ТекстыНачальных.Вставить(Ресурс.Ключ, КартографическиеДанныеКлиентV2.ТекстРесурса(Тело));
		ДобавитьВПакет(Сборщик, Ресурс.Ключ, Тело);
	КонецЦикла;

	Остальные = ОстальныеРесурсыНабора(ТекстыНачальных, ПараметрыНабора);
	Счетчики.Всего = Счетчики.Всего + Остальные.Количество();
	Для Каждого Ресурс Из Остальные Цикл
		Если Загрузка.Отмена Тогда
			Возврат Неопределено;
		КонецЕсли;
		Тело = Ждать СкачатьРесурсАсинх(Соединения, Ресурс, Счетчики);
		Если Тело <> Неопределено Тогда
			ДобавитьВПакет(Сборщик, Ресурс.Ключ, Тело);
		КонецЕсли;
	КонецЦикла;
	Если Загрузка.Отмена Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЗаписатьПакет(КартографическиеДанныеКлиентV2.ЗабратьПакет(Сборщик));

	Манифест = Новый Структура;
	Манифест.Вставить("Пакетов", Сборщик.Номер);
	Манифест.Вставить("Ресурсов", Сборщик.Ресурсов);
	Манифест.Вставить("Пропущено", Счетчики.Пропущено);
	Манифест.Вставить("Байт", Сборщик.Байт);
	Возврат Манифест;

КонецФункции

// Возвращаемое значение:
//  Обещание - результат - ДвоичныеДанные; Неопределено, если необязательный ресурс пропущен
//    (404 у тайла или шрифта, пустой ответ).
&НаКлиенте
Асинх Функция СкачатьРесурсАсинх(Соединения, Ресурс, Счетчики)

	Результат = Ждать КартографическиеДанныеКлиентV2.СкачатьАсинх(Соединения, Ресурс);
	Счетчики.Скачано = Счетчики.Скачано + 1;
	ПоказатьПрогресс(Счетчики, Ресурс.Ключ);
	Если Результат.Статус = "ok" Тогда
		Возврат Результат.Тело;
	КонецЕсли;
	Если Не Ресурс.Обязательный И (Результат.Статус = "missing" Или Результат.Статус = "empty") Тогда
		Счетчики.Пропущено = Счетчики.Пропущено + 1;
		Возврат Неопределено;
	КонецЕсли;
	Если Ресурс.ПропуститьПриОшибке Тогда
		// Например, морская обстановка: её можно догрузить позже, набор без неё лучше потерянного часа загрузки.
		Счетчики.Пропущено = Счетчики.Пропущено + 1;
		ДобавитьВХод(СтрШаблон(НСтр("ru = 'Пропущен %1: %2'"), Ресурс.Ключ, Результат.Текст));
		Возврат Неопределено;
	КонецЕсли;
	ВызватьИсключение ?(ПустаяСтрока(Результат.Текст), Ресурс.Ключ, Результат.Текст);

КонецФункции

&НаКлиенте
Процедура ДобавитьВПакет(Сборщик, Ключ, Тело)

	Если КартографическиеДанныеКлиентV2.ДобавитьРесурс(Сборщик, Ключ, Тело) Тогда
		ЗаписатьПакет(КартографическиеДанныеКлиентV2.ЗабратьПакет(Сборщик));
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Пакет - см. КартографическиеДанныеКлиентV2.ЗабратьПакет
&НаКлиенте
Процедура ЗаписатьПакет(Пакет)

	Если Пакет <> Неопределено Тогда
		ЗаписатьПакетНаСервере(Загрузка.Набор, Пакет.Номер, Пакет.Текст, Пакет.Количество);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПрогресс(Счетчики, Ключ)

	// Строка хода обновляется не на каждом тайле: тысячи перерисовок многострочного поля заметно тормозят.
	Если Счетчики.Скачано % 20 <> 0 И Счетчики.Скачано <> Счетчики.Всего Тогда
		Возврат;
	КонецЕсли;
	Состояние(СтрШаблон(НСтр("ru = 'Скачано %1 из %2 (%3 МБ), пропущено %4, передано пакетов %5'"),
		Счетчики.Скачано, Счетчики.Всего, Формат(Счетчики.Сборщик.Байт / 1048576, "ЧДЦ=1; ЧН=0"),
		Счетчики.Пропущено, Счетчики.Сборщик.Номер),
		?(Счетчики.Всего = 0, 0, Окр(Счетчики.Скачано * 100 / Счетчики.Всего)), Ключ);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВХод(Текст)

	// Метка - время от начала загрузки: по ней видно, сколько ещё ждать.
	Метка = ?(Загрузка = Неопределено, "",
		ПредставлениеДлительности(ТекущаяУниверсальнаяДатаВМиллисекундах() - Загрузка.Начало) + "  ");
	Ход = ?(ПустаяСтрока(Ход), "", Ход + Символы.ПС) + Метка + Текст;

КонецПроцедуры

&НаКлиенте
Функция ПредставлениеДлительности(Миллисекунды)

	Секунды = Окр(Миллисекунды / 1000);
	Возврат СтрШаблон(НСтр("ru = '%1 мин %2 с'"), Цел(Секунды / 60), Секунды % 60);

КонецФункции

&НаСервере
Функция ОписаниеПараметров(ПараметрыНабора)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Район (lon/lat): %1'"), СтрСоединить(ЧислаСтроками(ПараметрыНабора.bbox), ", ")));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Масштабы тайлов: %1-%2'"), ПараметрыНабора.minZoom, ПараметрыНабора.maxZoom));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Стили: %1'"), СтрСоединить(ПараметрыНабора.styles, ", ")));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Диапазоны шрифтов: %1'"), СтрСоединить(ПараметрыНабора.glyphRanges, ", ")));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Морская обстановка: %1'"), СтрСоединить(ПараметрыНабора.overpassHosts, ", ")));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Размер пакета: %1 символов'"), Формат(ПараметрыНабора.packageSize, "ЧГ=3")));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервере
Функция ЧислаСтроками(Числа)

	Результат = Новый Массив;
	Для Каждого Число Из Числа Цикл
		Результат.Добавить(Формат(Число, "ЧРД=.; ЧГ=0"));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция НачатьНаборНаСервере()

	Возврат КартографическиеДанныеV2.НачатьНабор();

КонецФункции

&НаСервереБезКонтекста
Функция НачальныеРесурсыНабора(ПараметрыНабора)

	Возврат КартографическиеДанныеV2.НачальныеРесурсы(ПараметрыНабора);

КонецФункции

&НаСервереБезКонтекста
Функция ОстальныеРесурсыНабора(ТекстыНачальных, ПараметрыНабора)

	Возврат КартографическиеДанныеV2.ОстальныеРесурсы(ТекстыНачальных, ПараметрыНабора);

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьПакетНаСервере(Набор, Номер, ТекстПакета, КоличествоРесурсов)

	КартографическиеДанныеV2.ЗаписатьПакет(Набор, Номер, ТекстПакета, КоличествоРесурсов);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗавершитьНаборНаСервере(Набор, Манифест)

	КартографическиеДанныеV2.ЗавершитьНабор(Набор, Манифест);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьНаборНаСервере(Набор)

	КартографическиеДанныеV2.ОтменитьНабор(Набор);

КонецПроцедуры

#КонецОбласти
