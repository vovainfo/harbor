#Область ПрограммныйИнтерфейс

// Собирает страницу карты: макеты, MapLibre и начальные данные - параметры района, последний снимок судов,
// активный набор картографии (идентификатор и число пакетов), слои морской обстановки и список
// отслеживаемых судов. Картографических данных в HTML нет: их форма переносит пакетами после события ready.
//
// Возвращаемое значение:
//  Структура:
//   * HTML - Строка - текст страницы для поля HTML-документа;
//   * ДатаПолучения - Дата - дата вшитого снимка, UTC; пустая дата, если снимка нет;
//   * ВерсияСписка - Строка - версия вшитого списка отслеживаемых судов;
//   * Состояние - Строка - строка состояния формы.
Функция СобратьHTMLКарты() Экспорт

	Снимок = ПолучениеДанныхAISV2.ПоследнийСнимок();
	ДанныеСнимка = ?(ЗначениеЗаполнено(Снимок.ДатаПолучения), Снимок.ДанныеJSON, "null");
	Набор = КартографическиеДанныеV2.АктивныйНабор();
	Список = Справочники.ОтслеживаемыеСудаV2.СписокДляКарты();
	ДанныеНабора = "null";
	Если ЗначениеЗаполнено(Набор.Набор) Тогда
		ДанныеНабора = ТекстJSON(Новый Структура("id, packages", Набор.Набор, Набор.Пакетов));
	КонецЕсли;
	// Макет слоёв - готовый JSON-массив, вставляется без разбора.
	НачальныеДанные = "{""region"":" + ТекстJSON(ПолучениеДанныхAISV2.ПараметрыРайона())
		+ ",""snapshot"":" + ДанныеСнимка
		+ ",""set"":" + ДанныеНабора
		+ ",""seamarkLayers"":" + ПолучитьМакет("СтильМорскойОбстановки").ПолучитьТекст()
		+ ",""watchlist"":" + Список.Текст + "}";

	Подстановки = Новый Соответствие;
	Подстановки.Вставить("MAP_CSS", ПолучитьМакет("МакетCSS").ПолучитьТекст());
	Подстановки.Вставить("MAP_JS", ПолучитьМакет("МакетJS").ПолучитьТекст());
	// JSON попадает внутрь <script>: "</" закрыл бы тег, если встретится в имени судна.
	Подстановки.Вставить("INITIAL_DATA", СтрЗаменить(НачальныеДанные, "</", "<\/"));

	Результат = Новый Структура;
	Результат.Вставить("HTML", СобратьСтраницу("МакетHTML", Подстановки));
	Результат.Вставить("ДатаПолучения", Снимок.ДатаПолучения);
	Результат.Вставить("ВерсияСписка", Список.Версия);
	Результат.Вставить("Состояние", ТекстСостояния(Снимок, Набор));
	Возврат Результат;

КонецФункции

// Команда setWatchlist с текущим списком отслеживаемых судов - для оповещения карты из карточки судна.
//
// Возвращаемое значение:
//  Структура:
//   * ТекстКоманды - Строка - JSON команды;
//   * Версия - Строка - версия списка в команде.
Функция КомандаСпискаОтслеживаемых() Экспорт

	Список = Справочники.ОтслеживаемыеСудаV2.СписокДляКарты();
	Результат = Новый Структура;
	Результат.Вставить("ТекстКоманды", ТекстКомандыСписка(Список));
	Результат.Вставить("Версия", Список.Версия);
	Возврат Результат;

КонецФункции

// Собирает страницу диагностики HTML-поля с той же библиотекой MapLibre, что и карта.
//
// Возвращаемое значение:
//  Строка - текст страницы.
Функция СобратьHTMLДиагностики() Экспорт

	Подстановки = Новый Соответствие;
	Подстановки.Вставить("REGION", ТекстJSON(ПолучениеДанныхAISV2.ПараметрыРайона()));
	Возврат СобратьСтраницу("ДиагностикаHTML", Подстановки);

КонецФункции

// Данные очередного такта опроса формы.
//
// Параметры:
//  ИзвестнаяДата - Дата - дата снимка, уже показанного на карте, UTC;
//  ИзвестнаяВерсияСписка - Строка - версия списка отслеживаемых судов, уже показанного на карте.
//
// Возвращаемое значение:
//  Структура:
//   * Состояние - Строка - строка состояния формы;
//   * ДатаПолучения - Дата - дата последнего снимка, UTC;
//   * ВерсияСписка - Строка - текущая версия списка отслеживаемых судов;
//   * Команды - Массив из Строка - команды карты по порядку: updateVessels, если снимок новее известного,
//     setWatchlist, если версия списка другая. Каждая строка - отдельный вызов моста.
Функция ОбновлениеКарты(ИзвестнаяДата, ИзвестнаяВерсияСписка) Экспорт

	Снимок = ПолучениеДанныхAISV2.ПоследнийСнимок();
	Список = Справочники.ОтслеживаемыеСудаV2.СписокДляКарты();
	Результат = Новый Структура;
	Результат.Вставить("Состояние", ТекстСостояния(Снимок, КартографическиеДанныеV2.АктивныйНабор()));
	Результат.Вставить("ДатаПолучения", ИзвестнаяДата);
	Результат.Вставить("ВерсияСписка", Список.Версия);
	Результат.Вставить("Команды", Новый Массив);
	Если Снимок.ДатаПолучения > ИзвестнаяДата Тогда
		Результат.ДатаПолучения = Снимок.ДатаПолучения;
		// Готовая строка снимка вставляется в команду без разбора: она идёт в атрибут, а не в <script>.
		Результат.Команды.Добавить("{""op"":""updateVessels"",""snapshot"":" + Снимок.ДанныеJSON + "}");
	КонецЕсли;
	Если Список.Версия <> ИзвестнаяВерсияСписка Тогда
		Результат.Команды.Добавить(ТекстКомандыСписка(Список));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Строка состояния формы по снимку и набору картографии. Время - местное время сеанса.
//
// Параметры:
//  Снимок - см. ПолучениеДанныхAISV2.ПоследнийСнимок
//  Набор - см. КартографическиеДанныеV2.АктивныйНабор
//
// Возвращаемое значение:
//  Строка
Функция ТекстСостояния(Снимок, Набор) Экспорт

	Части = Новый Массив;
	Если ЗначениеЗаполнено(Снимок.ДатаПолучения) Тогда
		Сейчас = ТекущаяУниверсальнаяДата();
		// Без второго аргумента МестноеВремя берёт пояс компьютера, а не пояс сеанса.
		Части.Добавить(СтрШаблон(НСтр("ru = 'Снимок: %1 (получен %2 назад)'"),
			МестноеПредставление(Снимок.ДатаПолучения), ПредставлениеВозраста(Сейчас - Снимок.ДатаПолучения)));
		Части.Добавить(СтрШаблон(НСтр("ru = 'судов: %1'"), Снимок.КоличествоСудов));
		Если ЗначениеЗаполнено(Снимок.СамаяСвежаяПозиция) Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'самая свежая позиция: %1 назад'"),
				ПредставлениеВозраста(Снимок.ДатаПолучения - Снимок.СамаяСвежаяПозиция)));
		КонецЕсли;
	Иначе
		Части.Добавить(НСтр("ru = 'Снимка AIS ещё нет'"));
	КонецЕсли;
	Части.Добавить(НСтр("ru = 'источник: Open Waters'"));
	Если ЗначениеЗаполнено(Набор.Набор) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'карта от %1'"), МестноеПредставление(Набор.ДатаАктивации)));
	Иначе
		Части.Добавить(НСтр("ru = 'картографические данные не загружены'"));
	КонецЕсли;
	Возврат СтрСоединить(Части, " · ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подставляет в макет страницы плейсхолдеры /*@@ИМЯ@@*/, общий код кеша и библиотеку MapLibre.
// Библиотека вставляется последней, чтобы поиск остальных плейсхолдеров не шёл по мегабайту её текста.
Функция СобратьСтраницу(ИмяМакета, Подстановки)

	Текст = ПолучитьМакет(ИмяМакета).ПолучитьТекст();
	Для Каждого Подстановка Из Подстановки Цикл
		Текст = СтрЗаменить(Текст, Плейсхолдер(Подстановка.Ключ), Подстановка.Значение);
	КонецЦикла;
	Текст = СтрЗаменить(Текст, Плейсхолдер("CACHE_JS"), ПолучитьМакет("КешКартыJS").ПолучитьТекст());
	Текст = СтрЗаменить(Текст, Плейсхолдер("MAPLIBRE_CSS"), ПолучитьМакет("МаплибреCSS").ПолучитьТекст());
	Текст = СтрЗаменить(Текст, Плейсхолдер("MAPLIBRE_JS"), ПолучитьМакет("МаплибреJS").ПолучитьТекст());
	Возврат Текст;

КонецФункции

// Параметры:
//  Список - см. Справочники.ОтслеживаемыеСудаV2.СписокДляКарты
Функция ТекстКомандыСписка(Список)

	Возврат "{""op"":""setWatchlist"",""watchlist"":" + Список.Текст + "}";

КонецФункции

Функция Плейсхолдер(Имя)

	Возврат "/*@@" + Имя + "@@*/";

КонецФункции

Функция ТекстJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция МестноеПредставление(ДатаUTC)

	Возврат Формат(МестноеВремя(ДатаUTC, ЧасовойПоясСеанса()), "ДФ='dd.MM.yyyy HH:mm'");

КонецФункции

Функция ПредставлениеВозраста(Секунды)

	Минуты = Макс(0, Цел(Секунды / 60));
	Если Минуты < 60 Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 мин'"), Минуты);
	КонецЕсли;
	Часы = Цел(Минуты / 60);
	Если Часы < 24 Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 ч %2 мин'"), Часы, Минуты % 60);
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = '%1 сут %2 ч'"), Цел(Часы / 24), Часы % 24);

КонецФункции

#КонецОбласти

#КонецЕсли
