#Область ПрограммныйИнтерфейс

// Собирает страницу карты: макеты, MapLibre и начальные данные (параметры района и последний снимок).
//
// Возвращаемое значение:
//  Структура:
//   * HTML - Строка - текст страницы для поля HTML-документа;
//   * ДатаПолучения - Дата - дата вшитого снимка, UTC; пустая дата, если снимка нет;
//   * Состояние - Строка - строка состояния формы.
Функция СобратьHTMLКарты() Экспорт

	Снимок = ПолучениеДанныхAISV1.ПоследнийСнимок();
	ДанныеСнимка = ?(ЗначениеЗаполнено(Снимок.ДатаПолучения), Снимок.ДанныеJSON, "null");
	НачальныеДанные = "{""region"":" + ТекстJSON(ПолучениеДанныхAISV1.ПараметрыРайона())
		+ ",""snapshot"":" + ДанныеСнимка + "}";

	Подстановки = Новый Соответствие;
	Подстановки.Вставить("MAP_CSS", ПолучитьМакет("МакетCSS").ПолучитьТекст());
	Подстановки.Вставить("MAP_JS", ПолучитьМакет("МакетJS").ПолучитьТекст());
	// JSON попадает внутрь <script>: "</" закрыл бы тег, если встретится в имени судна.
	Подстановки.Вставить("INITIAL_DATA", СтрЗаменить(НачальныеДанные, "</", "<\/"));

	Результат = Новый Структура;
	Результат.Вставить("HTML", СобратьСтраницу("МакетHTML", Подстановки));
	Результат.Вставить("ДатаПолучения", Снимок.ДатаПолучения);
	Результат.Вставить("Состояние", ТекстСостояния(Снимок));
	Возврат Результат;

КонецФункции

// Собирает страницу диагностики HTML-поля с той же библиотекой MapLibre, что и карта.
//
// Возвращаемое значение:
//  Строка - текст страницы.
Функция СобратьHTMLДиагностики() Экспорт

	Подстановки = Новый Соответствие;
	Подстановки.Вставить("REGION", ТекстJSON(ПолучениеДанныхAISV1.ПараметрыРайона()));
	Возврат СобратьСтраницу("ДиагностикаHTML", Подстановки);

КонецФункции

// Данные очередного такта опроса формы.
//
// Параметры:
//  ИзвестнаяДата - Дата - дата снимка, уже показанного на карте, UTC.
//
// Возвращаемое значение:
//  Структура:
//   * Состояние - Строка - строка состояния формы;
//   * ДатаПолучения - Дата - дата последнего снимка, UTC;
//   * ТекстКоманды - Строка - команда updateVessels, если снимок новее известного; иначе пустая строка.
Функция ОбновлениеКарты(ИзвестнаяДата) Экспорт

	Снимок = ПолучениеДанныхAISV1.ПоследнийСнимок();
	Результат = Новый Структура;
	Результат.Вставить("Состояние", ТекстСостояния(Снимок));
	Результат.Вставить("ДатаПолучения", ИзвестнаяДата);
	Результат.Вставить("ТекстКоманды", "");
	Если Снимок.ДатаПолучения > ИзвестнаяДата Тогда
		Результат.ДатаПолучения = Снимок.ДатаПолучения;
		// Готовая строка снимка вставляется в команду без разбора: она идёт в атрибут, а не в <script>.
		Результат.ТекстКоманды = "{""op"":""updateVessels"",""snapshot"":" + Снимок.ДанныеJSON + "}";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Строка состояния формы по снимку. Время снимка - местное время сеанса.
//
// Параметры:
//  Снимок - см. ПолучениеДанныхAISV1.ПоследнийСнимок
//
// Возвращаемое значение:
//  Строка
Функция ТекстСостояния(Снимок) Экспорт

	Если Не ЗначениеЗаполнено(Снимок.ДатаПолучения) Тогда
		Возврат НСтр("ru = 'Снимка AIS ещё нет. Источник: Open Waters'");
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДата();
	// Без второго аргумента МестноеВремя берёт пояс компьютера, а не пояс сеанса.
	ВремяСнимка = МестноеВремя(Снимок.ДатаПолучения, ЧасовойПоясСеанса());
	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Снимок: %1 (получен %2 назад)'"),
		Формат(ВремяСнимка, "ДФ='dd.MM.yyyy HH:mm'"), ПредставлениеВозраста(Сейчас - Снимок.ДатаПолучения)));
	Части.Добавить(СтрШаблон(НСтр("ru = 'судов: %1'"), Снимок.КоличествоСудов));
	Если ЗначениеЗаполнено(Снимок.СамаяСвежаяПозиция) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'самая свежая позиция: %1 назад'"),
			ПредставлениеВозраста(Снимок.ДатаПолучения - Снимок.СамаяСвежаяПозиция)));
	КонецЕсли;
	Части.Добавить(НСтр("ru = 'источник: Open Waters'"));
	Возврат СтрСоединить(Части, " · ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подставляет в макет страницы плейсхолдеры /*@@ИМЯ@@*/ и библиотеку MapLibre.
// Библиотека вставляется последней, чтобы поиск остальных плейсхолдеров не шёл по мегабайту её текста.
Функция СобратьСтраницу(ИмяМакета, Подстановки)

	Текст = ПолучитьМакет(ИмяМакета).ПолучитьТекст();
	Для Каждого Подстановка Из Подстановки Цикл
		Текст = СтрЗаменить(Текст, Плейсхолдер(Подстановка.Ключ), Подстановка.Значение);
	КонецЦикла;
	Текст = СтрЗаменить(Текст, Плейсхолдер("MAPLIBRE_CSS"), ПолучитьМакет("МаплибреCSS").ПолучитьТекст());
	Текст = СтрЗаменить(Текст, Плейсхолдер("MAPLIBRE_JS"), ПолучитьМакет("МаплибреJS").ПолучитьТекст());
	Возврат Текст;

КонецФункции

Функция Плейсхолдер(Имя)

	Возврат "/*@@" + Имя + "@@*/";

КонецФункции

Функция ТекстJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ПредставлениеВозраста(Секунды)

	Минуты = Макс(0, Цел(Секунды / 60));
	Если Минуты < 60 Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 мин'"), Минуты);
	КонецЕсли;
	Часы = Цел(Минуты / 60);
	Если Часы < 24 Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 ч %2 мин'"), Часы, Минуты % 60);
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = '%1 сут %2 ч'"), Цел(Часы / 24), Часы % 24);

КонецФункции

#КонецОбласти

#КонецЕсли
