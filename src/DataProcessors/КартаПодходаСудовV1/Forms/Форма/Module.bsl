#Область ОписаниеПеременных

// Текст команды, которую мост карты ещё не принял: отправляется на следующем такте или по событию ready.
&НаКлиенте
Перем ОжидающаяКомандаКарты;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = НСтр("ru = 'Карта подхода судов (V1)'");
	Элементы.ПолучитьДанныеСейчас.Видимость = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.СнимкиAISV1);

	Сборка = Обработки.КартаПодходаСудовV1.СобратьHTMLКарты();
	HTML = Сборка.HTML;
	ДатаСнимка = Сборка.ДатаПолучения;
	Состояние = Сборка.Состояние;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОжидающаяКомандаКарты = "";
	ПодключитьОбработчикОжидания("ОбновитьКартуПоТакту", ПериодОпросаСекунд(), Ложь);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КартаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Href = "";
	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Href = Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;

	// Ссылки атрибуции (OSM, OpenSeaMap, AISHub) открываются в браузере, а не внутри поля карты.
	Если СтрНачинаетсяС(НРег(Href), "http://") Или СтрНачинаетсяС(НРег(Href), "https://") Тогда
		СтандартнаяОбработка = Ложь;
		ПерейтиПоНавигационнойСсылке(Href);
		Возврат;
	КонецЕсли;

	ПозицияСобытия = СтрНайти(Href, "#event:");
	Если ПозицияСобытия = 0 Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;

	ТипСобытия = Сред(Href, ПозицияСобытия + СтрДлина("#event:"));
	Если ТипСобытия = "ready" Тогда
		// Не внутри обработчика клика карты: команда снова вызывает JS, пусть стек событий сначала завершится.
		ПодключитьОбработчикОжидания("ОтправитьОжидающуюКоманду", 0.1, Истина);
	ИначеЕсли ТипСобытия = "error" Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Карта: %1'"), АтрибутУзлаСобытия(ДанныеСобытия, "data-message"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПолучитьДанныеСейчас(Команда)

	Результат = ПолучитьДанныеСейчасНаСервере(ДатаСнимка);
	Если Не Результат.Успешно Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Ошибка получения данных: %1'"), Результат.ТекстОшибки);
		СообщитьПользователю(Состояние);
		Возврат;
	КонецЕсли;
	ПрименитьОбновление(Результат.Обновление);
	СообщитьПользователю(СтрШаблон(НСтр("ru = 'Снимок обновлён: принято судов %1, пропущено %2'"),
		Результат.КоличествоСудов, Результат.Пропущено));

КонецПроцедуры

&НаКлиенте
Процедура Диагностика(Команда)

	ОткрытьФорму("Обработка.КартаПодходаСудовV1.Форма.Диагностика", , ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьКартуПоТакту()

	ОтправитьОжидающуюКоманду();
	ПрименитьОбновление(ОбновлениеКарты(ДатаСнимка));

КонецПроцедуры

// Серверные вызовы без контекста: иначе на каждом такте туда и обратно передавался бы мегабайт HTML формы.
&НаСервереБезКонтекста
Функция ОбновлениеКарты(ИзвестнаяДата)

	Возврат Обработки.КартаПодходаСудовV1.ОбновлениеКарты(ИзвестнаяДата);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеСейчасНаСервере(ИзвестнаяДата)

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоСудов", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Обновление", Неопределено);
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.СнимкиAISV1) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Недостаточно прав для обновления снимка AIS'");
		Возврат Результат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(Результат, ПолучениеДанныхAISV1.ОбновитьСнимокOpenWaters());
	Если Результат.Успешно Тогда
		Результат.Обновление = Обработки.КартаПодходаСудовV1.ОбновлениеКарты(ИзвестнаяДата);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Параметры:
//  Обновление - см. Обработки.КартаПодходаСудовV1.ОбновлениеКарты
&НаКлиенте
Процедура ПрименитьОбновление(Обновление)

	Состояние = Обновление.Состояние;
	Если Не ПустаяСтрока(Обновление.ТекстКоманды) Тогда
		ДатаСнимка = Обновление.ДатаПолучения;
		ОтправитьКомандуКарте(Обновление.ТекстКоманды);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОжидающуюКоманду()

	Если Не ПустаяСтрока(ОжидающаяКомандаКарты) Тогда
		ОтправитьКомандуКарте(ОжидающаяКомандаКарты);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКомандуКарте(ТекстКоманды)

	ОжидающаяКомандаКарты = ТекстКоманды;
	Попытка
		Если ОтправитьВМостКарты(ТекстКоманды) Тогда
			ОжидающаяКомандаКарты = "";
		КонецЕсли;
	Исключение
		ОжидающаяКомандаКарты = "";
		Состояние = СтрШаблон(НСтр("ru = 'Карта не приняла данные: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Передаёт команду в #map-command-bridge, как мост цифрового двойника D3.
//
// Возвращаемое значение:
//  Булево - Ложь, если мост ещё не готов принимать команды.
&НаКлиенте
Функция ОтправитьВМостКарты(ТекстКоманды)

	Попытка
		Мост = Элементы.Карта.Документ.getElementById("map-command-bridge");
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если Мост = Неопределено Или АтрибутHTML(Мост, "data-ready") <> "true" Тогда
		Возврат Ложь;
	КонецЕсли;

	НомерКоманды = 0;
	ПредыдущийНомер = АтрибутHTML(Мост, "data-seq");
	Если Не ПустаяСтрока(ПредыдущийНомер) Тогда
		НомерКоманды = Число(ПредыдущийНомер);
	КонецЕсли;
	НомерКоманды = Формат(НомерКоманды + 1, "ЧГ=0");

	Мост.setAttribute("data-ack", "");
	Мост.setAttribute("data-error", "");
	Мост.setAttribute("data-payload", ТекстКоманды);
	Мост.setAttribute("data-seq", НомерКоманды);
	Попытка
		Мост.click();
	Исключение
		Мост.fireEvent("onclick");
	КонецПопытки;

	Если АтрибутHTML(Мост, "data-ack") <> НомерКоманды Тогда
		ВызватьИсключение НСтр("ru = 'Карта не подтвердила команду'");
	КонецЕсли;
	ТекстОшибки = АтрибутHTML(Мост, "data-error");
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Атрибут узла, по которому кликнул JS (#map-event-bridge): данные события лежат в его data-*.
&НаКлиенте
Функция АтрибутУзлаСобытия(ДанныеСобытия, ИмяАтрибута)

	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Узел = Неопределено;
	КонецПопытки;
	Если Узел = Неопределено Тогда
		Попытка
			Узел = ДанныеСобытия.Element;
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЕсли;
	Возврат АтрибутHTML(Узел, ИмяАтрибута);

КонецФункции

&НаКлиенте
Функция АтрибутHTML(Узел, ИмяАтрибута)

	Попытка
		Значение = Узел.getAttribute(ИмяАтрибута);
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

&НаКлиенте
Процедура СообщитьПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

&НаКлиенте
Функция ПериодОпросаСекунд()

	Возврат 30;

КонецФункции

#КонецОбласти
